# ==========================================
# FRONTEND (Astro -> Vercel)
# ==========================================
# Must start with PUBLIC_ for Astro client-side access
PUBLIC_API_BASE_URL=http://localhost:8000
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ==========================================
# BACKEND (Python API -> Render)
# ==========================================
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:4321
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# ==========================================
# DATABASE & STORAGE (Supabase)
# ==========================================
# Pooler connection string (port 6543) for Render runtime
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# Direct connection string (port 5432) for schema migrations
DIRECT_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==========================================
# REDIS LOCKING & CACHE (Upstash)
# ==========================================
# Used for the two-buyers-one-item checkout lock
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
REDIS_URL=rediss://default:your-password@your-instance.upstash.io:6379