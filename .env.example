# Frontend settings. Copy to .env (in the repo root) and fill in.
# Only variables starting with PUBLIC_ reach the browser, so never put secrets here.

PUBLIC_API_URL=http://localhost:8000
PUBLIC_SUPABASE_URL=https://PROJECTREF.supabase.co
# The "anon" / "publishable" key. It's safe to expose in the browser.
PUBLIC_SUPABASE_ANON_KEY=
