# ==========================================
# FRONTEND (Astro -> Vercel)
# ==========================================
# Copy to .env (in the repo root) and fill in.
# Only variables starting with PUBLIC_ reach the browser, so never put secrets here.
# Leave PUBLIC_API_BASE_URL empty to run the screens on seed data.
PUBLIC_API_BASE_URL=http://localhost:8000/api
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "anon" / "publishable" key. It is safe to expose in the browser.
PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
