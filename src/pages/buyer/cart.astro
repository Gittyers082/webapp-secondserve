---
import AppLayout from '../../layouts/AppLayout.astro';
import FoodArt from '../../components/FoodArt.astro';
import { buyer, cart, cartItemCount, cartShopCount, cartTotal } from '../../data/store';
import { peso } from '../../data/types';
import type { CartLine } from '../../data/types';

/** The cart groups by shop, because each shop is a separate pickup. */
const shops = cart.reduce<Record<string, CartLine[]>>((groups, line) => {
  (groups[line.shopName] ??= []).push(line);
  return groups;
}, {});

const isEmpty = cart.length === 0;
---

<AppLayout
  role="buyer"
  username={buyer.username}
  section="View Cart"
  heading="View Cart"
  subtitle="Reserve now, collect from each shop before closing."
  accent="before closing."
>
  {
    isEmpty ? (
      <div class="empty">
        <h2>Your cart is empty.</h2>
        <p>Browse the Shop to find discounted food.</p>
        <a class="btn btn-dark" href="/buyer/shop">
          Browse the shop
        </a>
      </div>
    ) : (
      <div class="cart" data-cart>
        <div class="lines">
          {Object.entries(shops).map(([shopName, lines]) => (
            <section class="shop-group">
              <header class="shop-head">
                <h2>{shopName}</h2>
                <p class="small muted">&middot; Pickup: {lines[0]!.pickupLocation}</p>
              </header>

              <table class="table">
                <thead>
                  <tr>
                    <th>Item</th>
                    <th>Quantity</th>
                    <th>Price</th>
                    <th>Expiry</th>
                    <th><span class="sr-only">Actions</span></th>
                  </tr>
                </thead>
                <tbody>
                  {lines.map((line) => (
                    <tr data-line={line.listingId}>
                      <td>
                        <div class="item">
                          <span class="item-art">
                            <FoodArt art={line.art} />
                          </span>
                          <span class="item-name">{line.foodName}</span>
                        </div>
                      </td>
                      <td class="tnum">&times; {line.quantity}</td>
                      <td>
                        <p class="line-total tnum">{peso(line.quantity * line.unitPrice)}</p>
                        <p class="small muted tnum">{peso(line.unitPrice)} each</p>
                      </td>
                      <td>
                        <p>{line.expiryLabel}</p>
                        {line.expiringSoon && <span class="chip chip-lime expiry-chip">Expiring soon</span>}
                      </td>
                      <td>
                        <div class="line-actions">
                          <button class="btn btn-sm" type="button">
                            Edit quantity
                          </button>
                          <button class="btn btn-sm btn-danger" type="button" data-remove={line.listingId}>
                            Remove
                          </button>
                        </div>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </section>
          ))}
        </div>

        <aside class="summary panel">
          <p class="eyebrow">Order summary</p>

          <div class="row-between summary-line">
            <span>
              <span data-item-count>{cartItemCount}</span> items &middot; {cartShopCount} shops
            </span>
            <span class="tnum" data-subtotal>
              {peso(cartTotal)}
            </span>
          </div>

          <div class="row-between total">
            <span>Total</span>
            <span class="tnum" data-total>
              {peso(cartTotal)}
            </span>
          </div>

          <p class="hint">
            Reserving holds the food for you. Collect each order from its shop before the expiry time.
          </p>

          <a class="btn btn-primary btn-lg btn-block" href="/buyer/pending">
            Checkout
          </a>
        </aside>
      </div>
    )
  }
</AppLayout>

<script>
  import { peso } from '../../data/types';

  const rows = () => Array.from(document.querySelectorAll<HTMLElement>('[data-line]'));

  const recalculate = () => {
    let total = 0;
    let items = 0;

    rows().forEach((row) => {
      if (row.hidden) return;
      const lineTotal = row.querySelector<HTMLElement>('.line-total')?.textContent ?? '0';
      const quantity = row.querySelector<HTMLElement>('td.tnum')?.textContent ?? '0';
      total += Number(lineTotal.replace(/[^\d.]/g, ''));
      items += Number(quantity.replace(/[^\d.]/g, ''));
    });

    const totalNode = document.querySelector<HTMLElement>('[data-total]');
    const subtotalNode = document.querySelector<HTMLElement>('[data-subtotal]');
    const countNode = document.querySelector<HTMLElement>('[data-item-count]');

    if (totalNode) totalNode.textContent = peso(total);
    if (subtotalNode) subtotalNode.textContent = peso(total);
    if (countNode) countNode.textContent = String(items);
  };

  document.querySelectorAll<HTMLButtonElement>('[data-remove]').forEach((button) => {
    button.addEventListener('click', () => {
      const row = button.closest<HTMLElement>('[data-line]');
      if (!row) return;
      row.hidden = true;

      // Drop the whole shop group once its last line is gone.
      const group = row.closest<HTMLElement>('.shop-group');
      const remaining = group?.querySelectorAll<HTMLElement>('[data-line]:not([hidden])').length ?? 0;
      if (group && remaining === 0) group.hidden = true;

      recalculate();
    });
  });
</script>

<style>
  .cart {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: 40px;
    align-items: start;
  }

  .shop-group + .shop-group {
    margin-top: 34px;
  }

  .shop-head {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }

  .shop-head h2 {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .item {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .item-art {
    width: 48px;
    flex: none;
  }

  .item-name {
    font-weight: 600;
    font-size: 14.5px;
  }

  .line-total {
    font-weight: 700;
    font-size: 15px;
  }

  .expiry-chip {
    margin-top: 6px;
  }

  .line-actions {
    display: flex;
    gap: 8px;
    justify-content: flex-end;
  }

  .summary-line {
    margin-top: 16px;
    font-size: 14px;
  }

  .total {
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid var(--line-strong);
    font-size: 20px;
    font-weight: 700;
  }

  .total span:last-child {
    font-size: 30px;
  }

  .summary .hint {
    margin: 16px 0 20px;
  }

  @media (max-width: 1100px) {
    .cart {
      grid-template-columns: 1fr;
    }
  }
</style>
