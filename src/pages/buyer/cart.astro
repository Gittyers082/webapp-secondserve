---
import AppLayout from '../../layouts/AppLayout.astro';
import FoodArt from '../../components/FoodArt.astro';
import { buyer, cart, cartItemCount, cartShopCount, cartTotal } from '../../data/store';
import { peso } from '../../data/types';
import type { CartLine } from '../../data/types';

/** The cart groups by shop, because each shop is a separate pickup. */
const shops = cart.reduce<Record<string, CartLine[]>>((groups, line) => {
  (groups[line.shopName] ??= []).push(line);
  return groups;
}, {});

const isEmpty = cart.length === 0;
---

<AppLayout
  role="buyer"
  username={buyer.username}
  section="View Cart"
  heading="View Cart"
  subtitle="Reserve now, collect from each shop before closing."
  accent="before closing."
>
  <div class="empty" data-cart-empty hidden={!isEmpty}>
    <h2>Your cart is empty.</h2>
    <p>Browse the Shop to find discounted food.</p>
    <a class="btn btn-dark" href="/buyer/shop">
      Browse the shop
    </a>
  </div>

  {
    !isEmpty && (
      <div class="cart" data-cart>
        <div class="lines">
      {Object.entries(shops).map(([shopName, lines]) => (
        <section class="shop-group">
          <header class="shop-head">
            <h2>{shopName}</h2>
            <p class="small muted">&middot; Pickup: {lines[0]!.pickupLocation}</p>
          </header>

          <div class="table-wrap">
          <table class="table">
            <thead>
              <tr>
                <th>Item</th>
                <th class="num">Quantity</th>
                <th class="num">Price</th>
                <th>Expiry</th>
                <th><span class="sr-only">Actions</span></th>
              </tr>
            </thead>
            <tbody>
              {lines.map((line) => (
                <tr data-line={line.listingId}>
                  <td>
                    <div class="item">
                      <span class="item-art">
                        <FoodArt art={line.art} />
                      </span>
                      <span class="item-name" data-line-name>{line.foodName}</span>
                    </div>
                  </td>
                  <td class="num" data-qty={line.quantity}>&times; {line.quantity}</td>
                  <td class="num">
                    <p class="line-total" data-line-total={line.quantity * line.unitPrice}>
                      {peso(line.quantity * line.unitPrice)}
                    </p>
                    <p class="small muted">{peso(line.unitPrice)} each</p>
                  </td>
                  <td>
                    <p>{line.expiryLabel}</p>
                    {line.expiringSoon && <span class="chip chip-lime expiry-chip">Expiring soon</span>}
                  </td>
                  <td class="actions">
                    <div class="line-actions">
                      <button class="btn btn-sm" type="button" aria-label={`Edit quantity: ${line.foodName}`}>
                        Edit quantity
                      </button>
                      <button
                        class="btn btn-sm btn-danger"
                        type="button"
                        data-remove={line.listingId}
                        aria-label={`Remove ${line.foodName}`}
                      >
                        Remove
                      </button>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          </div>
        </section>
      ))}
    </div>

    <aside class="summary panel">
      <p class="eyebrow">Order summary</p>

      <div class="row-between summary-line">
        <span>
          <span data-item-count>{cartItemCount}</span> items &middot; <span data-shop-count>{cartShopCount}</span> shops
        </span>
        <span class="tnum" data-subtotal>
          {peso(cartTotal)}
        </span>
      </div>

      <div class="row-between total">
        <span>Total</span>
        <span class="tnum" data-total>
          {peso(cartTotal)}
        </span>
      </div>

      <p class="hint">
        Reserving holds the food for you. Collect each order from its shop before the expiry time.
      </p>

      <a class="btn btn-primary btn-lg btn-block" href="/buyer/pending">
        Checkout
      </a>
    </aside>
  </div>
    )
  }
</AppLayout>

<script>
  import { peso } from '../../data/types';
  import { announce } from '../../scripts/announce';

  const rows = () => Array.from(document.querySelectorAll<HTMLElement>('[data-line]:not([hidden])'));

  const recalculate = () => {
    let total = 0;
    let items = 0;

    rows().forEach((row) => {
      total += Number(row.querySelector<HTMLElement>('[data-line-total]')?.dataset.lineTotal ?? 0);
      items += Number(row.querySelector<HTMLElement>('[data-qty]')?.dataset.qty ?? 0);
    });

    const shops = document.querySelectorAll('.shop-group:not([hidden])').length;
    const set = (selector: string, value: string) => {
      const node = document.querySelector<HTMLElement>(selector);
      if (node) node.textContent = value;
    };

    set('[data-total]', peso(total));
    set('[data-subtotal]', peso(total));
    set('[data-item-count]', String(items));
    set('[data-shop-count]', String(shops));

    return { total, items };
  };

  document.querySelectorAll<HTMLButtonElement>('[data-remove]').forEach((button) => {
    button.addEventListener('click', () => {
      const row = button.closest<HTMLElement>('[data-line]');
      if (!row) return;
      const name = row.querySelector<HTMLElement>('[data-line-name]')?.textContent ?? 'Item';
      row.hidden = true;

      // Drop the whole shop group once its last line is gone.
      const group = row.closest<HTMLElement>('.shop-group');
      const remaining = group?.querySelectorAll<HTMLElement>('[data-line]:not([hidden])').length ?? 0;
      if (group && remaining === 0) group.hidden = true;

      const { total } = recalculate();

      if (rows().length === 0) {
        document.querySelector<HTMLElement>('[data-cart]')?.setAttribute('hidden', '');
        const empty = document.querySelector<HTMLElement>('[data-cart-empty]');
        if (empty) empty.hidden = false;
        empty?.querySelector<HTMLElement>('a')?.focus();
        announce(`${name} removed. Your cart is empty.`);
        return;
      }

      // Focus moves to the next remove button so keyboard users keep their place.
      rows()[0]?.querySelector<HTMLButtonElement>('[data-remove]')?.focus();
      announce(`${name} removed. Total is now ${peso(total)}.`);
    });
  });
</script>

<style>
  .cart {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 40px;
    align-items: start;
  }

  .shop-group + .shop-group {
    margin-top: 34px;
  }

  .shop-head {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }

  .shop-head h2 {
    font-size: var(--fs-data);
    font-weight: 700;
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
  }

  /* Both shop groups share one set of column widths so they line up. */
  .lines .table {
    table-layout: fixed;
  }

  .lines .table th:nth-child(2) { width: 96px; }
  .lines .table th:nth-child(3) { width: 120px; }
  .lines .table th:nth-child(4) { width: 170px; }
  .lines .table th:nth-child(5) { width: 250px; }

  .item {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .item-art {
    width: 48px;
    flex: none;
  }

  .item-name {
    font-weight: 600;
  }

  .line-total {
    font-weight: 700;
    font-size: var(--fs-body);
  }

  .expiry-chip {
    margin-top: 6px;
  }

  .line-actions {
    display: flex;
    gap: 8px;
    justify-content: flex-end;
  }

  .summary-line {
    margin-top: 16px;
    font-size: var(--fs-data);
  }

  .total {
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid var(--line-strong);
    font-size: var(--fs-title-s);
    font-weight: 700;
  }

  .total span:last-child {
    font-size: var(--fs-display-m);
    font-variant-numeric: tabular-nums;
  }

  .summary {
    position: sticky;
    top: calc(var(--topbar-h) + 16px);
  }

  .summary .hint {
    margin: 16px 0 20px;
  }

  @media (max-width: 1100px) {
    .cart {
      grid-template-columns: 1fr;
    }

    .summary {
      position: static;
      max-width: 480px;
      margin-left: auto;
    }
  }
</style>
