---
import AppLayout from '../../layouts/AppLayout.astro';
import ListingCard from '../../components/ListingCard.astro';
import FoodArt from '../../components/FoodArt.astro';
import Icon from '../../components/Icon.astro';
import QuantityStepper from '../../components/QuantityStepper.astro';
import { buyer, cart, cartItemCount, cartTotal, listings } from '../../data/store';
import { peso, discountPercent } from '../../data/types';
import type { FoodArt as FoodArtKey } from '../../data/types';

const featured = listings[0]!;
const available = listings.filter((listing) => listing.status !== 'expired').length;

const categories: { id: string; label: string; art: FoodArtKey }[] = [
  { id: 'all', label: 'All', art: 'mystery' },
  { id: 'bread', label: 'Bread', art: 'pandesal-plain' },
  { id: 'pastries', label: 'Pastries', art: 'croissant' },
  { id: 'savory', label: 'Savory', art: 'empanada' },
  { id: 'cakes', label: 'Cakes', art: 'cake-slice' },
  { id: 'fruit-cups', label: 'Fruit cups', art: 'strawberry-cup' },
];

const counted = categories.map((category) => ({
  ...category,
  count:
    category.id === 'all'
      ? listings.length
      : listings.filter((listing) => listing.category === category.id).length,
}));
---

<AppLayout
  role="buyer"
  username={buyer.username}
  section="Shop"
  heading="Shop"
  subtitle={`${available} listings from Baguio shops, discounted before they expire.`}
  highlight={`${available} listings`}
>
  <div class="search">
    <label class="sr-only" for="shop-search">Search shop or food</label>
    <input class="input" id="shop-search" type="search" placeholder="Search a shop or a food" data-search />
    <span class="search-button" aria-hidden="true"><Icon name="search" /></span>
  </div>

  <!-- Categories --------------------------------------------------------- -->
  <section class="section" aria-labelledby="categories-title">
    <div class="section-head">
      <div>
        <h2 class="section-title" id="categories-title">Categories</h2>
        <p class="section-sub"><span class="hl">{counted.length - 1} categories</span> on the shelves today</p>
      </div>
    </div>

    <div class="categories" role="group" aria-label="Filter by category">
      {
        counted.map((category) => (
          <button class="category" type="button" data-filter={category.id} aria-pressed={category.id === 'all'}>
            <span class="category-photo">
              <FoodArt art={category.art} ratio="1 / 1" eager />
            </span>
            <span class="category-label">{category.label}</span>
            <span class="category-count tnum">{category.count}</span>
          </button>
        ))
      }
    </div>
  </section>

  <!-- Today's pick ------------------------------------------------------- -->
  <section class="section" aria-labelledby="pick-title">
    <article class="pick">
      <div class="pick-photo">
        <FoodArt art={featured.art} ratio="4 / 3" eager />
        <span class="pill pill-lime pick-badge">Expiring soon</span>
      </div>
      <div class="pick-copy">
        <p class="label">Today&rsquo;s pick from {featured.shopName}</p>
        <h2 class="pick-title" id="pick-title">Soft ube pandesal with melted cheese, half price tonight.</h2>
        <p class="pick-blurb">
          Baked this morning and still fresh. Collect it from Session Road before 6:00 PM tomorrow, then give your
          name at the counter.
        </p>
        <div class="pick-foot">
          <p class="price">
            <del><span class="sr-only">Was </span>{peso(featured.originalPrice)}</del>
            <ins><span class="sr-only">Now </span>{peso(featured.discountedPrice)}</ins>
          </p>
          <span class="discount">{discountPercent(featured)}% off</span>
          <span class="soft small tnum">{featured.quantity} left</span>
          <a class="btn btn-primary" href={`/buyer/listing/${featured.id}`}>See details</a>
        </div>
      </div>
    </article>
  </section>

  <!-- Shelves ------------------------------------------------------------ -->
  <section id="shelves" class="section" aria-labelledby="shelves-title">
    <div class="section-head">
      <div>
        <h2 class="section-title" id="shelves-title">Fresh from today&rsquo;s shelves</h2>
        <p class="section-sub">Select a photo to choose it, then add it to your cart from the panel.</p>
      </div>
    </div>

    <div class="listing-grid" data-grid>
      {listings.map((listing) => <ListingCard listing={listing} selectable selected={listing.id === featured.id} />)}
    </div>

    <p class="no-results" data-no-results hidden>
      Nothing matches that search. Try a shop name such as &ldquo;Mang Ben&rsquo;s&rdquo;, or choose All.
    </p>
  </section>

  <!-- Rail --------------------------------------------------------------- -->
  <Fragment slot="rail">
    <div class="panel rail-panel">
      <div class="panel-inset pickup">
        <h2 class="rail-title">Pickup</h2>
        <p class="pickup-line">
          <Icon name="pin" size={18} />
          <span data-selection-pickup>{featured.pickupLocation}</span>
        </p>
        <p class="pickup-line">
          <Icon name="clock" size={18} />
          <span>Collect before <span data-selection-expiry>{featured.expiryLabel.toLowerCase()}</span></span>
        </p>
      </div>

      <div class="selected" data-selection>
        <h2 class="rail-subtitle">Selected</h2>
        <div class="selected-item">
          <span class="selected-photo">
            <img class="photo" src={`/photos/${featured.art}.jpg`} alt="" data-selection-photo />
          </span>
          <div class="selected-copy">
            <p class="selected-name" data-selection-name>{featured.name}</p>
            <p class="small muted" data-selection-meta>{featured.shopName} &middot; {featured.quantity} in stock</p>
            <p class="selected-price tnum" data-selection-price>{peso(featured.discountedPrice)}</p>
          </div>
        </div>
        <QuantityStepper value={2} max={featured.quantity} name="shop" />
        <button class="btn btn-primary btn-block btn-lg" type="button" data-add-to-cart>Add to cart</button>
        <a class="btn btn-block" href={`/buyer/listing/${featured.id}`} data-selection-link>View details</a>
      </div>

      <div class="cart-summary">
        <div class="row-between">
          <h2 class="rail-subtitle">
            <Icon name="cart" size={18} />
            Your cart
          </h2>
          <span class="small muted tnum">{cartItemCount} items</span>
        </div>
        <ul class="cart-lines">
          {
            cart.map((line) => (
              <li class="cart-line">
                <span class="cart-line-photo">
                  <FoodArt art={line.art} ratio="1 / 1" />
                </span>
                <span class="cart-line-name">
                  {line.foodName}
                  <span class="small muted tnum">&times; {line.quantity}</span>
                </span>
                <span class="tnum">{peso(line.quantity * line.unitPrice)}</span>
              </li>
            ))
          }
        </ul>
        <div class="row-between cart-total">
          <span>Total</span>
          <span class="tnum">{peso(cartTotal)}</span>
        </div>
        <a class="btn btn-dark btn-block btn-lg" href="/buyer/cart">View cart</a>
      </div>
    </div>
  </Fragment>

</AppLayout>

<script>
  import { savedListingIds } from '../../data/store';
  import { initWishlist } from '../../scripts/wishlist';
  import { setupFilters } from '../../scripts/filters';
  import { setupSelection } from '../../scripts/selection';

  initWishlist(savedListingIds);

  const cards = () => Array.from(document.querySelectorAll<HTMLElement>('article[data-listing]'));
  const field = (name: string) => document.querySelector<HTMLElement>(`[data-selection-${name}]`);

  setupFilters({
    items: cards,
    noun: 'listing',
    container: document.querySelector<HTMLElement>('[data-grid]'),
    matches: (card, category, term) => {
      const inCategory = category === 'all' || card.dataset.category === category;
      const inSearch =
        term === '' || (card.dataset.name ?? '').includes(term) || (card.dataset.shop ?? '').includes(term);
      return inCategory && inSearch;
    },
  });

  setupSelection({
    cards,
    canSelect: (card) => card.dataset.status !== 'expired',
    onSelect: (card) => {
      const name = card.querySelector<HTMLElement>('[data-card-name]')?.textContent ?? '';
      const shop = card.querySelector<HTMLElement>('[data-card-shop]')?.textContent ?? '';
      const source = card.querySelector<HTMLImageElement>('img');

      const set = (key: string, value: string) => {
        const node = field(key);
        if (node) node.textContent = value;
      };

      set('name', name);
      set('meta', `${shop} · ${card.dataset.qty ?? ''} in stock`);
      set('price', card.dataset.price ?? '');
      set('expiry', (card.dataset.expiry ?? '').toLowerCase());
      set('pickup', shop);

      const photo = document.querySelector<HTMLImageElement>('[data-selection-photo]');
      if (photo && source) photo.src = source.src;

      const link = document.querySelector<HTMLAnchorElement>('[data-selection-link]');
      if (link) link.href = `/buyer/listing/${card.dataset.listing}`;
    },
  });

  document.querySelectorAll<HTMLButtonElement>('[data-add-to-cart]').forEach((button) => {
    button.addEventListener('click', () => {
      window.location.href = '/buyer/cart';
    });
  });
</script>

<style>
  /* Categories ------------------------------------------------------------ */

  .categories {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    padding: 4px 4px 8px;
    margin: -4px;
  }

  .category {
    display: grid;
    justify-items: center;
    gap: 8px;
    flex: none;
    width: 92px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--text-soft);
  }

  .category-photo {
    width: 84px;
    height: 84px;
    border-radius: 50%;
    overflow: hidden;
    opacity: 0.62;
    filter: saturate(0.7);
    transition: opacity var(--dur) var(--ease-out), filter var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }

  .category-photo :global(.food-photo) {
    border-radius: 50%;
  }

  .category:hover .category-photo {
    opacity: 0.9;
    transform: translateY(-2px);
  }

  /* The chosen category comes forward: full colour, a touch larger. */
  .category[aria-pressed='true'] .category-photo {
    opacity: 1;
    filter: none;
    transform: scale(1.06);
  }

  .category-label {
    font-size: var(--fs-md);
    font-weight: 600;
    color: var(--text);
  }

  .category[aria-pressed='true'] .category-label {
    color: var(--brick-text);
  }

  .category-count {
    margin-top: -6px;
    font-size: var(--fs-xs);
    color: var(--muted);
  }

  /* Today's pick ---------------------------------------------------------- */

  .pick {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 32px;
    align-items: center;
    padding: 12px;
    border-radius: var(--r-xl);
    background: var(--s2);
    -webkit-backdrop-filter: var(--blur);
    backdrop-filter: var(--blur);
  }

  .pick-photo {
    position: relative;
  }

  .pick-photo :global(.food-photo) {
    border-radius: var(--r-lg);
  }

  .pick-badge {
    position: absolute;
    top: 14px;
    left: 14px;
  }

  .pick-copy {
    padding: 12px 20px 12px 0;
  }

  .pick-title {
    margin-top: 8px;
    font-size: 24px;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .pick-blurb {
    margin-top: 12px;
    color: var(--text-soft);
    font-size: var(--fs-md);
    line-height: 1.6;
    max-width: 52ch;
  }

  .pick-foot {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 24px;
  }

  .pick-foot .price ins {
    font-size: var(--fs-h2);
  }

  .pick-foot .btn {
    margin-left: auto;
  }

  /* Rail ------------------------------------------------------------------ */


  .rail-title {
    font-size: var(--fs-h3);
    font-weight: 700;
    margin-bottom: 12px;
  }

  .rail-subtitle {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: var(--fs-lg);
    font-weight: 700;
  }

  .pickup-line {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    color: var(--text-soft);
    font-size: var(--fs-md);
    font-weight: 600;
  }

  .pickup-line + .pickup-line {
    margin-top: 8px;
  }

  .pickup-line :global(svg) {
    flex: none;
    margin-top: 1px;
    color: var(--muted);
  }

  .selected {
    display: grid;
    gap: 16px;
    padding: 0 8px;
  }

  .selected-item {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .selected-photo {
    width: 76px;
    height: 76px;
    flex: none;
    border-radius: var(--r-md);
    overflow: hidden;
  }

  .selected-copy {
    min-width: 0;
  }

  .selected-name {
    font-weight: 700;
  }

  .selected-price {
    margin-top: 4px;
    font-size: var(--fs-lg);
    font-weight: 700;
  }

  .cart-summary {
    display: grid;
    gap: 16px;
    padding: 16px 8px 4px;
  }

  .cart-lines {
    display: grid;
    gap: 12px;
  }

  .cart-line {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    font-size: var(--fs-md);
  }

  .cart-line-photo :global(.food-photo) {
    border-radius: var(--r-sm);
  }

  .cart-line-name {
    display: grid;
    line-height: 1.3;
  }

  .cart-total {
    padding: 12px 16px;
    border-radius: var(--r-md);
    background: var(--s3);
    font-size: var(--fs-h3);
    font-weight: 700;
  }

  @media (max-width: 1279px) {
    .pick {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 20px;
    }

    .pick-title {
      font-size: var(--fs-h2);
    }

    .pick-blurb {
      display: none;
    }

    .pick-foot .btn {
      margin-left: 0;
    }
  }


  @media (max-width: 699px) {
    .pick {
      grid-template-columns: 1fr;
    }

    .pick-copy {
      padding: 4px 8px 8px;
    }

    .pick-blurb {
      display: block;
    }
  }
</style>
