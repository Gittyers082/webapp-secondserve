---
import AppLayout from '../../layouts/AppLayout.astro';
---



<AppLayout
  role="partner"
  username="Loading..."
  section="My Orders"
  heading="My Orders"
  subtitle="Loading your orders..."
  
>
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th>Food</th>
          <th>Shop</th>
          <th class="num">Qty</th>
          <th class="num">Paid</th>
          <th>Fulfillment</th>
          <th>Status</th>
          <th><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody data-partner-orders-body></tbody>
    </table>
  </div>

  <p class="hint" data-orders-loading role="status">Loading your orders...</p>

  <p class="hint page-note">
    Mark an order distributed once the food has reached the people you serve. It counts toward the food rescued in Baguio.
  </p>
</AppLayout>

<script>
  import { initPartnerOrders } from '../../scripts/partner-orders';
  void initPartnerOrders();
</script>
