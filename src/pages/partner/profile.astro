---
import AppLayout from '../../layouts/AppLayout.astro';
import ProfilePanel from '../../components/ProfilePanel.astro';
import { organizationTypeLabel } from '../../data/types';
import type { OrganizationType } from '../../data/types';
const types = Object.entries(organizationTypeLabel) as [OrganizationType, string][];
---



<AppLayout
  role="partner"
  username="Loading..."
  section="Organization Profile"
  heading="Organization Profile"
  subtitle="Loading organization details..."
  
>
  <p class="hint" data-profile-loading role="status">Loading your organization profile...</p>
  <form class="panel org" method="post" data-org-form hidden>
    <h2 class="panel-title">Organization details</h2>
    <p class="hint">Shops see the organization name on every order you place.</p>

    <div class="field-row">
      <div class="field">
        <label class="field-label" for="org-name">Organization name</label>
        <input class="input" id="org-name" name="organizationName" value="" required />
      </div>
      <div class="field">
        <label class="field-label" for="org-type">Type</label>
        <select class="input" id="org-type" name="organizationType">
          {types.map(([value, label]) => <option value={value} >{label}</option>)}
        </select>
      </div>
    </div>

    <div class="field-row">
      <div class="field">
        <label class="field-label" for="org-contact">Contact person</label>
        <input class="input" id="org-contact" name="contactPerson" value="" required autocomplete="name" />
      </div>
      <div class="field">
        <label class="field-label" for="org-address">Address</label>
        <input class="input" id="org-address" name="address" value="" required autocomplete="street-address" />
      </div>
    </div>

    <div class="field">
      <label class="field-label" for="org-accreditation">Accreditation or registration link (optional)</label>
      <input class="input" id="org-accreditation" name="accreditationUrl" type="url" value="" placeholder="https://" />
    </div>

    <div class="form-foot">
      <button class="btn btn-primary" type="submit">Save details</button>
      <p class="form-status" data-org-status hidden></p>
    </div>
  </form>

  <ProfilePanel username="Loading..." role="partner" />
</AppLayout>

<script>
  import { initPartnerProfile } from '../../scripts/partner-profile';
  void initPartnerProfile();
</script>

<style>
  .org[hidden] { display: none; }
  .org {
    display: grid;
    gap: 16px;
    margin-bottom: var(--gutter);
  }

  .form-foot {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .form-status {
    color: var(--ok);
    font-size: var(--fs-sm);
    font-weight: 600;
  }
</style>
