---
import AppLayout from '../../layouts/AppLayout.astro';
import NotificationCenter from '../../components/NotificationCenter.astro';
import { partner, partnerNotifications, unreadCount } from '../../data/store';

const unread = unreadCount(partnerNotifications);
---

<AppLayout
  role="partner"
  username={partner.username}
  section="Notifications"
  heading="Notifications"
  subtitle={`${unread} unread. New surplus, deliveries and account news in one place.`}
  highlight={`${unread} unread`}
>
  <NotificationCenter items={partnerNotifications} />
</AppLayout>
