---
import AppLayout from '../../layouts/AppLayout.astro';
import { activeSessions, admin } from '../../data/store';
import { roleLabel } from '../../data/nav';
import Icon from '../../components/Icon.astro';
---

<AppLayout
  role="admin"
  username={admin.username}
  section="Active Sessions"
  heading="Active Sessions"
  subtitle={`${activeSessions.length} people are connected right now.`}
  highlight={`${activeSessions.length} people`}
>
  <button class="btn" type="button" data-refresh slot="actions">
    <Icon name="refresh" />
    <span data-refresh-label>Refresh</span>
  </button>

  <div class="table-wrap">
  <table class="table">
    <thead>
      <tr>
        <th>Username</th>
        <th>Role</th>
        <th>Connected since</th>
        <th>Client address</th>
      </tr>
    </thead>
    <tbody>
      {
        activeSessions.map((session) => (
          <tr>
            <td class="name">
              <span class="who">
                <span class="avatar" aria-hidden="true">{session.username.charAt(0)}</span>
                {session.username}
              </span>
            </td>
            <td>{roleLabel[session.role]}</td>
            <td class="muted">{session.connectedSince}</td>
            <td class="muted tnum">{session.clientAddress}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
  </div>
</AppLayout>

<script>
  import { announce } from '../../scripts/announce';

  const button = document.querySelector<HTMLButtonElement>('[data-refresh]');

  button?.addEventListener('click', () => {
    const label = button.querySelector<HTMLElement>('[data-refresh-label]');
    if (!label) return;
    const original = label.textContent;
    label.textContent = 'Refreshing…';
    button.disabled = true;

    window.setTimeout(() => {
      label.textContent = original;
      button.disabled = false;
      button.focus();
      announce('Session list refreshed.');
    }, 700);
  });
</script>

