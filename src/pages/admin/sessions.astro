---
import AppLayout from '../../layouts/AppLayout.astro';
import { activeSessions, admin } from '../../data/store';
import { roleLabel } from '../../data/nav';
---

<AppLayout
  role="admin"
  username={admin.username}
  section="Active Sessions"
  heading="Active Sessions"
  subtitle="Who is connected right now."
>
  <div class="toolbar">
    <span class="chip chip-mint">{activeSessions.length} online</span>
    <button class="btn btn-sm" type="button" data-refresh>Refresh</button>
  </div>

  <table class="table">
    <thead>
      <tr>
        <th>Username</th>
        <th>Role</th>
        <th>Connected since</th>
        <th>Client address</th>
      </tr>
    </thead>
    <tbody>
      {
        activeSessions.map((session) => (
          <tr>
            <td class="username">{session.username}</td>
            <td>{roleLabel[session.role]}</td>
            <td class="muted">{session.connectedSince}</td>
            <td class="muted tnum">{session.clientAddress}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</AppLayout>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-refresh]');

  button?.addEventListener('click', () => {
    const original = button.textContent;
    button.textContent = 'Refreshing…';
    button.disabled = true;

    window.setTimeout(() => {
      button.textContent = original;
      button.disabled = false;
    }, 700);
  });
</script>

<style>
  .toolbar {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 22px;
  }

  .username {
    font-size: 15px;
  }
</style>
