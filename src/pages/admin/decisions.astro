---
import AppLayout from '../../layouts/AppLayout.astro';
import { accountDecisions, admin } from '../../data/store';
---

<AppLayout
  role="admin"
  username={admin.username}
  section="Approved/Declined Users"
  heading="Approved/Declined Users"
  subtitle={`A record of all ${accountDecisions.length} past decisions.`}
  highlight={`${accountDecisions.length} past decisions`}
>
  <div class="table-wrap">
  <table class="table">
    <thead>
      <tr>
        <th>Username</th>
        <th>Account type</th>
        <th>Shop / business</th>
        <th>Decision</th>
        <th>Decided on</th>
      </tr>
    </thead>
    <tbody>
      {
        accountDecisions.map((entry) => (
          <tr>
            <td class="name">
              <span class="who">
                <span class="avatar" aria-hidden="true">{entry.username.charAt(0)}</span>
                {entry.username}
              </span>
            </td>
            <td>{entry.role === 'seller' ? 'Seller' : 'Buyer'}</td>
            <td class="muted">{entry.shopName ?? '—'}</td>
            <td>
              <span class:list={['pill', entry.decision === 'approved' ? 'pill-ok' : 'pill-danger']}>
                {entry.decision === 'approved' ? 'Approved' : 'Declined'}
              </span>
            </td>
            <td class="muted">{entry.decidedAt}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
  </div>
</AppLayout>

