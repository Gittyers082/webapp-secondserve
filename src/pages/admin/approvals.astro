---
import AppLayout from '../../layouts/AppLayout.astro';
import { admin, pendingAccounts } from '../../data/store';
import { roleLabel } from '../../data/nav';
---

<AppLayout
  role="admin"
  username={admin.username}
  section="Pending Approvals"
  heading="Pending Approvals"
  subtitle={`${pendingAccounts.length} new accounts are waiting for you.`}
  highlight={`${pendingAccounts.length} new accounts`}
>
  <div class="table-wrap" data-approvals>
  <table class="table">
    <thead>
      <tr>
        <th>Username</th>
        <th>Account type</th>
        <th>Shop / organization</th>
        <th>Requested</th>
        <th>Status</th>
        <th><span class="sr-only">Actions</span></th>
      </tr>
    </thead>
    <tbody>
      {
        pendingAccounts.map((account) => (
          <tr data-account={account.id}>
            <td class="name">
              <span class="who">
                <span class="avatar" aria-hidden="true">{account.username.charAt(0)}</span>
                {account.username}
              </span>
            </td>
            <td>{roleLabel[account.role]}</td>
            <td class="muted">{account.shopName ?? account.organizationName ?? '—'}</td>
            <td class="muted">{account.requestedAt}</td>
            <td>
              <span class="pill pill-neutral" data-decision-chip>Pending</span>
            </td>
            <td class="actions">
              <div class="row">
                <button class="btn btn-sm btn-light" type="button" data-decide="approved" aria-label={`Approve ${account.username}`}>
                  Approve
                </button>
                <button class="btn btn-sm btn-danger" type="button" data-decide="declined" aria-label={`Decline ${account.username}`}>
                  Decline
                </button>
              </div>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
  </div>

  <div class="empty" data-empty hidden>
    <h2>Nothing waiting.</h2>
    <p>Every new account has been reviewed. Decisions are kept in Approved/Declined Users.</p>
    <a class="btn btn-primary" href="/admin/decisions">See past decisions</a>
  </div>
</AppLayout>

<script>
  import { announce } from '../../scripts/announce';
  import { run } from '../../scripts/request';
  import { api } from '../../api/client';

  const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-account]'));

  const checkEmpty = () => {
    const remaining = rows.filter((row) => row.dataset.decided !== 'true').length;
    if (remaining > 0) return;

    const table = document.querySelector<HTMLElement>('[data-approvals]');
    const empty = document.querySelector<HTMLElement>('[data-empty]');
    if (table) table.hidden = true;
    if (empty) empty.hidden = false;
    empty?.querySelector<HTMLElement>('a')?.focus();
  };

  rows.forEach((row) => {
    row.querySelectorAll<HTMLButtonElement>('[data-decide]').forEach((button) => {
      button.addEventListener('click', async () => {
        const choice = button.dataset.decide === 'approved' ? 'approved' : 'declined';
        const saved = await run(button, () => api.admin.decide(row.dataset.account ?? '', choice));
        if (!saved) return;
        const decision = choice === 'approved' ? 'Approved' : 'Declined';
        const chip = row.querySelector<HTMLElement>('[data-decision-chip]');
        const actions = row.querySelector<HTMLElement>('.actions');

        if (chip) {
          chip.className = `pill ${decision === 'Approved' ? 'pill-ok' : 'pill-danger'}`;
          chip.textContent = decision;
        }

        if (actions) {
          const note = document.createElement('span');
          note.className = 'small muted';
          note.textContent = `${decision} just now`;
          actions.replaceChildren(note);
        }

        row.dataset.decided = 'true';
        announce(`${row.querySelector('.name')?.textContent?.trim() ?? 'Account'} ${decision.toLowerCase()}.`);
        checkEmpty();

        // The buttons are gone; keep keyboard focus on the next pending decision.
        rows
          .find((other) => other.dataset.decided !== 'true')
          ?.querySelector<HTMLButtonElement>('[data-decide]')
          ?.focus();
      });
    });
  });
</script>
