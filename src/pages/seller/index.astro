---
import AppLayout from '../../layouts/AppLayout.astro';
import ListingCard from '../../components/ListingCard.astro';
import FoodArt from '../../components/FoodArt.astro';
import Icon from '../../components/Icon.astro';
import ShopLogo from '../../components/ShopLogo.astro';
import { expiringWithinThreeDays, handoverQueue, seller, sellerListings, sellerProfile } from '../../data/store';

const nextToExpire = expiringWithinThreeDays[0]!;
const laterCount = sellerListings.length - expiringWithinThreeDays.length;

const stats = [
  { value: expiringWithinThreeDays.length, label: 'Expiring within 3 days', hot: true },
  { value: sellerListings.length, label: 'Total listed items' },
  { value: handoverQueue.length, label: 'Reserved orders' },
];
---

<AppLayout
  role="seller"
  username={seller.username}
  section="Overview"
  heading="Overview"
  subtitle={`${expiringWithinThreeDays.length} items at ${seller.shopName} expire within 3 days.`}
  highlight={`${expiringWithinThreeDays.length} items`}
>
  <section class="stats" aria-label="Shop at a glance">
    {
      stats.map((stat) => (
        <div class="stat">
          <p class:list={['stat-value tnum', { hot: stat.hot }]}>{stat.value}</p>
          <p class="label">{stat.label}</p>
        </div>
      ))
    }
  </section>

  <section class="section" aria-labelledby="expiring-title">
    <div class="section-head">
      <div>
        <h2 class="section-title" id="expiring-title">Your listings</h2>
        <p class="section-sub tnum" data-shown>Showing {expiringWithinThreeDays.length} of {sellerListings.length} items</p>
      </div>
      <label class="toggle">
        <input type="checkbox" role="switch" checked data-expiry-filter />
        <span class="track" aria-hidden="true"></span>
        <span class="toggle-label">Expiring within 3 days</span>
      </label>
    </div>

    <div class="listing-grid">
      {
        sellerListings.map((listing) => {
          const soon = expiringWithinThreeDays.includes(listing);
          return (
            <div class="cell" data-soon={String(soon)} hidden={!soon}>
              <ListingCard listing={listing} variant="seller" />
            </div>
          );
        })
      }

      <div class="grid-tile" data-later>
        <span class="grid-tile-icon" aria-hidden="true"><Icon name="clock" /></span>
        <p class="grid-tile-title">{laterCount} more items expire after Nov 7</p>
        <p class="small muted">Switch the filter off to see them.</p>
      </div>
    </div>
  </section>

  <Fragment slot="rail">
    <div class="panel rail-panel">
      <article class="next">
        <div class="next-photo">
          <FoodArt art={nextToExpire.art} ratio="16 / 10" />
          <span class="pill pill-lime next-badge">Next to expire</span>
        </div>
        <p class="next-name">{nextToExpire.name}</p>
        <p class="next-when">
          <Icon name="clock" size={16} />
          {nextToExpire.expiryLabel}
        </p>
      </article>

      <div class="shop-mini">
        <ShopLogo name={sellerProfile.shopName} logoUrl={sellerProfile.logoUrl} size={44} />
        <div class="shop-mini-copy">
          <p class="shop-mini-name">{sellerProfile.shopName}</p>
          <p class="small muted">{sellerProfile.tags.join(' · ')}</p>
        </div>
        <a class="btn btn-sm" href="/seller/shop-profile">Edit shop profile</a>
      </div>

      <div class="reserved">
        <div class="row-between">
          <h2 class="panel-title">Reserved orders</h2>
          <span class="count">{handoverQueue.length}</span>
        </div>
        <ul class="reserved-list">
          {
            handoverQueue.map((order) => (
              <li class="reserved-item">
                <span class="food-thumb"><FoodArt art={order.art} ratio="1 / 1" /></span>
                <span class="reserved-copy">
                  <span class="reserved-food">{order.foodName}</span>
                  <span class="small muted">{order.buyerUsername} &middot; &times; {order.quantity}</span>
                </span>
                <span class:list={['pill', order.status === 'ready' ? 'pill-ok' : 'pill-neutral']}>
                  {order.status === 'ready' ? 'Ready' : 'Reserved'}
                </span>
              </li>
            ))
          }
        </ul>
        <a class="btn btn-dark btn-block" href="/seller/handover">Open Reserved / Handover</a>
      </div>
    </div>
  </Fragment>
</AppLayout>

<script>
  import { announce } from '../../scripts/announce';

  const toggle = document.querySelector<HTMLInputElement>('[data-expiry-filter]');
  const cells = Array.from(document.querySelectorAll<HTMLElement>('.cell'));
  const later = document.querySelector<HTMLElement>('[data-later]');
  const shown = document.querySelector<HTMLElement>('[data-shown]');

  const render = () => {
    const filtered = toggle?.checked ?? true;
    let visible = 0;

    cells.forEach((cell) => {
      const show = !filtered || cell.dataset.soon === 'true';
      cell.hidden = !show;
      if (show) visible += 1;
    });

    if (later) later.hidden = !filtered;
    const message = `Showing ${visible} of ${cells.length} items`;
    if (shown) shown.textContent = message;
    announce(message);
  };

  toggle?.addEventListener('change', render);
</script>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-radius: var(--r-xl);
    background: var(--s2);
    -webkit-backdrop-filter: var(--blur);
    backdrop-filter: var(--blur);
  }

  .stat {
    padding: 24px 24px;
  }

  .stat-value {
    font-size: var(--fs-figure);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .stat-value.hot {
    color: var(--brick-text);
  }

  .stat .label {
    margin-top: 4px;
  }

  .toggle {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
    gap: 12px;
    flex: none;
    cursor: pointer;
  }

  .toggle input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .track {
    position: relative;
    width: 50px;
    height: 28px;
    border-radius: var(--r-pill);
    background: var(--s4);
    transition: background var(--dur) var(--ease-out);
  }

  .track::after {
    content: '';
    position: absolute;
    top: 4px;
    left: 4px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--text);
    transition: transform var(--dur) var(--ease-out), background var(--dur) var(--ease-out);
  }

  .toggle input:checked + .track {
    background: var(--brick);
  }

  .toggle input:checked + .track::after {
    transform: translateX(22px);
    background: #fff;
  }

  .toggle input:focus-visible + .track {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .toggle-label {
    font-size: var(--fs-md);
    font-weight: 600;
  }


  .next {
    padding: 12px 12px 16px;
    border-radius: var(--r-lg);
    background: var(--s3);
  }

  .next-photo {
    position: relative;
  }

  .next-badge {
    position: absolute;
    top: 10px;
    left: 10px;
  }

  .next-name {
    margin-top: 16px;
    padding: 0 8px;
    font-size: var(--fs-lg);
    font-weight: 700;
  }

  .next-when {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
    padding: 0 8px;
    color: var(--text-soft);
    font-size: var(--fs-md);
  }

  .shop-mini {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    align-items: center;
    gap: var(--sp-2) var(--sp-3);
    padding: var(--sp-4);
    border-radius: var(--r-lg);
    background: var(--s3);
  }

  .shop-mini .btn {
    grid-column: 1 / -1;
  }

  .shop-mini-name {
    font-weight: 700;
  }

  .reserved {
    display: grid;
    gap: 16px;
    padding: 0 8px 4px;
  }

  .reserved-list {
    display: grid;
    gap: 12px;
  }

  .reserved-item {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
  }

  .reserved-copy {
    display: grid;
    min-width: 0;
  }

  .reserved-food {
    font-size: var(--fs-md);
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 1279px) {
    .stat { padding: 16px 20px; }
  }

  @media (max-width: 599px) {
    .stats {
      grid-template-columns: 1fr;
    }

    .stat {
      padding: 16px 20px;
    }
  }
</style>
