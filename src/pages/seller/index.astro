---
import AppLayout from '../../layouts/AppLayout.astro';
import ListingCard from '../../components/ListingCard.astro';
import FoodArt from '../../components/FoodArt.astro';
import { expiringWithinThreeDays, handoverQueue, seller, sellerListings } from '../../data/store';

const nextToExpire = expiringWithinThreeDays[0]!;
const laterCount = sellerListings.length - expiringWithinThreeDays.length;

const stats = [
  { value: expiringWithinThreeDays.length, label: 'Expiring within 3 days', hot: true },
  { value: sellerListings.length, label: 'Total listed items' },
  { value: handoverQueue.length, label: 'Reserved orders' },
];
---

<AppLayout
  role="seller"
  username={seller.username}
  section="Overview"
  heading="Overview"
  subtitle={`What's nearing expiry at ${seller.shopName}.`}
  accent="nearing expiry"
>
  <section class="stats">
    {
      stats.map((stat) => (
        <article class="stat panel">
          <p class:list={['stat-value', { hot: stat.hot }]}>{stat.value}</p>
          <p class="eyebrow">{stat.label}</p>
        </article>
      ))
    }

    <article class="stat next">
      <span class="next-art">
        <FoodArt art={nextToExpire.art} />
      </span>
      <div>
        <p class="eyebrow next-label">Next to expire</p>
        <p class="next-name">{nextToExpire.name.replace(' (box of 6)', '')}</p>
        <p class="small">{nextToExpire.expiryLabel}</p>
      </div>
    </article>
  </section>

  <div class="toolbar">
    <label class="toggle">
      <input type="checkbox" checked data-expiry-filter />
      <span class="track" aria-hidden="true"></span>
      <span class="toggle-label">Expiring within 3 days</span>
    </label>
    <p class="small muted" data-shown>Showing {expiringWithinThreeDays.length} of {sellerListings.length} items</p>
  </div>

  <div class="grid">
    {
      sellerListings.map((listing) => {
        const soon = expiringWithinThreeDays.includes(listing);
        return (
          <div class="cell" data-soon={String(soon)} hidden={!soon}>
            <ListingCard listing={listing} variant="seller" />
          </div>
        );
      })
    }

    <div class="later panel-outline" data-later>
      <p class="later-head">{laterCount} more items expire after Nov 7.</p>
      <p class="later-note">Switch the filter off to see them.</p>
    </div>
  </div>
</AppLayout>

<script>
  const toggle = document.querySelector<HTMLInputElement>('[data-expiry-filter]');
  const cells = Array.from(document.querySelectorAll<HTMLElement>('.cell'));
  const later = document.querySelector<HTMLElement>('[data-later]');
  const shown = document.querySelector<HTMLElement>('[data-shown]');

  const render = () => {
    const filtered = toggle?.checked ?? true;
    let visible = 0;

    cells.forEach((cell) => {
      const show = !filtered || cell.dataset.soon === 'true';
      cell.hidden = !show;
      if (show) visible += 1;
    });

    if (later) later.hidden = !filtered;
    if (shown) shown.textContent = `Showing ${visible} of ${cells.length} items`;
  };

  toggle?.addEventListener('change', render);
</script>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  .stat {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 128px;
  }

  .stat-value {
    font-family: var(--display);
    font-size: 52px;
    line-height: 1;
    margin-bottom: 12px;
  }

  .stat-value.hot {
    color: var(--brick);
  }

  .next {
    flex-direction: row;
    align-items: center;
    gap: 18px;
    background: var(--lime);
    border-radius: var(--r-lg);
    padding: 24px;
  }

  .next-art {
    width: 76px;
    flex: none;
  }

  .next-art :global(.art) {
    background: rgba(255, 255, 255, 0.45);
  }

  .next-label {
    color: rgba(23, 21, 15, 0.6);
  }

  .next-name {
    margin: 4px 0 2px;
    font-size: 19px;
    font-weight: 600;
    line-height: 1.2;
  }

  .toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin: 32px 0 22px;
  }

  .toggle {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    cursor: pointer;
  }

  .toggle input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .track {
    position: relative;
    width: 54px;
    height: 28px;
    border-radius: var(--r-pill);
    background: var(--tan-deep);
    transition: background 0.18s ease;
  }

  .track::after {
    content: '';
    position: absolute;
    top: 4px;
    left: 4px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--ink);
    transition: transform 0.18s ease;
  }

  .toggle input:checked + .track {
    background: var(--lime);
  }

  .toggle input:checked + .track::after {
    transform: translateX(26px);
  }

  .toggle input:focus-visible + .track {
    outline: 2px solid var(--brick);
    outline-offset: 2px;
  }

  .toggle-label {
    font-size: 17px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 34px 30px;
  }

  .later {
    display: grid;
    place-content: center;
    text-align: center;
    padding: 40px 28px;
    min-height: 260px;
  }

  .later-head {
    font-family: var(--display);
    font-size: 25px;
    line-height: 1.2;
  }

  .later-note {
    margin-top: 10px;
    font-family: var(--display);
    font-size: 14px;
    color: var(--muted);
  }

  @media (max-width: 1200px) {
    .stats { grid-template-columns: repeat(2, 1fr); }
    .grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
