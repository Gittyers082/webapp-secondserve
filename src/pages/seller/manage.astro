---
import AppLayout from '../../layouts/AppLayout.astro';
import ListingCard from '../../components/ListingCard.astro';
import FoodArt from '../../components/FoodArt.astro';
import Dialog from '../../components/Dialog.astro';
import Icon from '../../components/Icon.astro';
import { seller, sellerListings } from '../../data/store';

const first = sellerListings[0]!;
---

<AppLayout
  role="seller"
  username={seller.username}
  section="Manage Listings"
  heading="Manage Listings"
  subtitle={`${sellerListings.length} listings. Edit what you listed or take it down.`}
  highlight={`${sellerListings.length} listings`}
>
  <div class="listing-grid">
    {
      sellerListings.map((listing, index) => (
        <ListingCard listing={listing} variant="seller" selectable selected={index === 0} />
      ))
    }

    <a class="grid-tile" href="/seller/add-listing">
      <span class="grid-tile-icon" aria-hidden="true"><Icon name="plus" /></span>
      <span class="grid-tile-title">Add a new listing</span>
      <span class="small muted">Open the Add Listing tab</span>
    </a>
  </div>

  <Fragment slot="rail">
    <div class="panel rail-panel" role="toolbar" aria-label="Selected listing" data-selection>
      <h2 class="panel-title">Selected listing</h2>
      <div class="rail-photo">
        <img class="photo" src={`/photos/${first.art}.jpg`} alt="" data-selection-photo />
      </div>
      <div>
        <p class="rail-name" data-selection-name>{first.name}</p>
        <p class="small muted" data-selection-meta>{first.quantity} left &middot; {first.expiryLabel}</p>
      </div>
      <div class="rail-actions">
        <button class="btn btn-light btn-block" type="button" data-dialog-open="edit-listing" aria-haspopup="dialog" data-needs-selection>
          <Icon name="pencil" />
          Edit listing
        </button>
        <div class="rail-pair">
          <button class="btn" type="button" data-mark-sold data-needs-selection>Mark as sold</button>
          <button class="btn" type="button" data-withdraw data-needs-selection>Withdraw</button>
        </div>
        <button class="btn btn-danger btn-block" type="button" data-dialog-open="delete-listing" aria-haspopup="dialog" data-needs-selection>
          <Icon name="trash" />
          Delete listing
        </button>
      </div>
      <p class="hint">Select a photo in the grid to choose which listing these act on.</p>
    </div>
  </Fragment>

  <!-- Edit ------------------------------------------------------------- -->
  <Dialog id="edit-listing" title="Edit listing" wide>
    <form class="edit" method="post" data-edit-form>
      <div class="edit-photo">
        <span class="field-label">Product photo</span>
        <div class="photo-frame"><FoodArt art={first.art} ratio="1 / 1" /></div>
        <div class="photo-actions">
          <button class="btn btn-sm btn-light" type="button">Retake with camera</button>
          <button class="btn btn-sm" type="button">Replace from file</button>
        </div>
      </div>

      <div class="edit-fields">
        <div class="field">
          <label class="field-label" for="edit-name">Food name</label>
          <input class="input" id="edit-name" name="name" value={first.name} required data-autofocus />
        </div>

        <div class="field-row">
          <div>
            <label class="field-label" for="edit-qty">Quantity</label>
            <input class="input" id="edit-qty" name="quantity" type="number" min="0" step="1" value={first.quantity} />
          </div>
          <div>
            <label class="field-label" for="edit-original">Original price (₱)</label>
            <input class="input" id="edit-original" name="originalPrice" type="number" min="1" step="0.01" value={first.originalPrice.toFixed(2)} />
          </div>
        </div>

        <div class="field-row">
          <div>
            <label class="field-label" for="edit-discounted">Discounted price (₱)</label>
            <input class="input" id="edit-discounted" name="discountedPrice" type="number" min="0" step="0.01" value={first.discountedPrice.toFixed(2)} />
          </div>
          <div>
            <label class="field-label" for="edit-date">Expiry date</label>
            <input class="input" id="edit-date" name="expiryDate" type="date" value="2026-11-05" />
          </div>
        </div>

        <div class="field-row">
          <div>
            <label class="field-label" for="edit-time">Expiry time</label>
            <input class="input" id="edit-time" name="expiryTime" type="time" value="18:00" />
          </div>
          <div>
            <label class="field-label" for="edit-pickup">Pickup location</label>
            <input class="input" id="edit-pickup" name="pickup" value={first.pickupLocation} />
          </div>
        </div>
      </div>

      <div class="dialog-actions edit-actions">
        <button class="btn" type="button" data-dialog-close>Cancel</button>
        <button class="btn btn-primary" type="submit">Save changes</button>
      </div>
    </form>
  </Dialog>

  <!-- Delete ----------------------------------------------------------- -->
  <Dialog
    id="delete-listing"
    title="Delete Ube Cheese Pandesal?"
    message="This cannot be undone. The listing and its photo will no longer appear in the Shop."
  >
    <div class="dialog-actions">
      <button class="btn" type="button" data-dialog-close>Cancel</button>
      <button class="btn btn-primary" type="button" data-confirm-delete>Delete</button>
    </div>
  </Dialog>
</AppLayout>

<script>
  import { announce } from '../../scripts/announce';
  import { closeDialog } from '../../scripts/dialog';
  import { setupSelection } from '../../scripts/selection';
  import { run } from '../../scripts/request';
  import { api } from '../../api/client';

  const cards = () => Array.from(document.querySelectorAll<HTMLElement>('article[data-listing]'));
  const deleteTitle = document.querySelector<HTMLElement>('[data-dialog="delete-listing"] [data-dialog-title]');

  /** The card title is uppercased by CSS; textContent keeps the real casing. */
  const nameOf = (card?: HTMLElement) =>
    card?.querySelector<HTMLElement>('h3')?.textContent?.replace(/\s*\(.*\)\s*$/, '') ?? '';

  const syncToolbar = () => {
    const card = selection.selected();

    document.querySelectorAll<HTMLButtonElement>('[data-needs-selection]').forEach((button) => {
      button.disabled = !card;
    });

    if (deleteTitle) deleteTitle.textContent = card ? `Delete ${nameOf(card)}?` : 'Delete this listing?';
  };

  const selection = setupSelection({
    cards,
    onSelect: (card) => {
      const name = document.querySelector<HTMLElement>('[data-selection-name]');
      const meta = document.querySelector<HTMLElement>('[data-selection-meta]');
      const photo = document.querySelector<HTMLImageElement>('[data-selection-photo]');
      const source = card.querySelector<HTMLImageElement>('img');
      if (name) name.textContent = card.querySelector('[data-card-name]')?.textContent ?? '';
      if (meta) meta.textContent = `${card.dataset.qty ?? ''} left · ${card.dataset.expiry ?? ''}`;
      if (photo && source) photo.src = source.src;
      syncToolbar();
    },
  });

  const setState = async (button: HTMLButtonElement, status: 'sold' | 'withdrawn') => {
    const card = selection.selected();
    const chip = card?.querySelector<HTMLElement>('[data-state]');
    if (!card || !chip) return;
    const saved = await run(button, () => api.seller.setStatus(card.dataset.listing ?? '', status));
    if (!saved) return;
    const label = status === 'sold' ? 'Sold' : 'Withdrawn';
    card.dataset.status = status;
    chip.className = 'pill pill-neutral';
    chip.textContent = label;
    announce(`${nameOf(card)} marked ${label.toLowerCase()}.`);
  };

  const markSold = document.querySelector<HTMLButtonElement>('[data-mark-sold]');
  markSold?.addEventListener('click', () => setState(markSold, 'sold'));

  const withdraw = document.querySelector<HTMLButtonElement>('[data-withdraw]');
  withdraw?.addEventListener('click', () => setState(withdraw, 'withdrawn'));

  const editForm = document.querySelector<HTMLFormElement>('[data-edit-form]');
  editForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const card = selection.selected();
    if (!card || !editForm.reportValidity()) return;
    const name = editForm.querySelector<HTMLInputElement>('[name="name"]')?.value.trim() ?? '';
    const saved = await run(editForm.querySelector<HTMLButtonElement>('[type="submit"]'), () =>
      api.seller.updateListing(card.dataset.listing ?? '', { name }),
    );
    if (saved === undefined) return;
    const title = card.querySelector<HTMLElement>('[data-card-name]');
    if (title && name) title.textContent = name;
    closeDialog();
    announce('Changes saved.');
  });

  document.querySelector<HTMLButtonElement>('[data-confirm-delete]')?.addEventListener('click', async (event) => {
    const card = selection.selected();
    const name = nameOf(card);
    if (!card) return;
    const done = await run(event.currentTarget as HTMLButtonElement, () =>
      api.seller.deleteListing(card.dataset.listing ?? ''),
    );
    if (done === undefined) return;
    closeDialog();
    card.remove();
    syncToolbar();
    // The opener was removed with nothing selected; keep focus in the grid.
    document.querySelector<HTMLElement>('[data-select]')?.focus();
    if (name) announce(`${name} deleted.`);
  });

  syncToolbar();
</script>

<style>

  .rail-photo {
    aspect-ratio: 4 / 3;
    border-radius: var(--r-lg);
    overflow: hidden;
  }

  .rail-name {
    font-size: var(--fs-lg);
    font-weight: 700;
  }

  .rail-actions {
    display: grid;
    gap: 12px;
  }

  .rail-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .edit {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 24px;
    margin-top: 16px;
  }

  .photo-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }

  .edit-actions {
    grid-column: 1 / -1;
  }

  @media (max-width: 800px) {
    .edit { grid-template-columns: 1fr; }
  }
</style>
