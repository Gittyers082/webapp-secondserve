---
import AppLayout from '../../layouts/AppLayout.astro';
import FoodArt from '../../components/FoodArt.astro';
import Icon from '../../components/Icon.astro';
import { handoverQueue, handoverRecord, seller } from '../../data/store';
import { peso } from '../../data/types';
---

<AppLayout
  role="seller"
  username={seller.username}
  section="Reserved / Handover"
  heading="Reserved / Handover"
  subtitle={`${handoverQueue.length} reservations to hand over, one pickup at a time.`}
  highlight={`${handoverQueue.length} reservations`}
>
  <p class="notice notice-info banner">
    <Icon name="info" />
    Mark ready for pickup updates the buyer&rsquo;s My Pending Orders (its status turns green).
  </p>

  <div class="table-wrap">
  <table class="table">
    <thead>
      <tr>
        <th>Food</th>
        <th>Buyer</th>
        <th class="num">Qty</th>
        <th>Status</th>
        <th>Pickup location</th>
        <th><span class="sr-only">Actions</span></th>
      </tr>
    </thead>
    <tbody>
      {
        handoverQueue.map((order) => (
          <tr data-order={order.id}>
            <td class="name">
              <span class="food-cell">
                <span class="food-thumb"><FoodArt art={order.art} ratio="1 / 1" /></span>
                {order.foodName}
              </span>
            </td>
            <td>
              <span class="who">
                <span class="avatar" aria-hidden="true">{order.buyerUsername.charAt(0)}</span>
                {order.buyerUsername}
              </span>
            </td>
            <td class="num">{order.quantity}</td>
            <td>
              <span
                class:list={['pill', order.status === 'ready' ? 'pill-ok' : 'pill-neutral']}
                data-status-chip
              >
                {order.status === 'ready' ? 'Ready for pickup' : 'Reserved'}
              </span>
            </td>
            <td class="muted">{order.pickupLocation}</td>
            <td class="actions">
              {order.status === 'ready' ? (
                <span class="small muted" data-waiting>
                  Waiting for buyer
                </span>
              ) : (
                <button class="btn btn-sm btn-light" type="button" data-ready={order.id} aria-label={`Mark ready for pickup: ${order.foodName} for ${order.buyerUsername}`}>
                  Mark ready for pickup
                </button>
              )}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
  </div>

  <section class="section record" aria-labelledby="record-title">
    <div class="section-head">
      <div>
        <h2 class="section-title" id="record-title">Order record</h2>
        <p class="section-sub"><span class="hl">{handoverRecord.length} completed</span> orders, saved for you and the buyer.</p>
      </div>
    </div>

    <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th>Food</th>
          <th>Buyer</th>
          <th class="num">Qty</th>
          <th class="num">Total</th>
          <th>Status</th>
          <th>Completed</th>
        </tr>
      </thead>
      <tbody>
        {
          handoverRecord.map((order) => (
            <tr>
              <td class="name">
                <span class="food-cell">
                  <span class="food-thumb"><FoodArt art={order.art} ratio="1 / 1" /></span>
                  {order.foodName}
                </span>
              </td>
              <td>
                <span class="who">
                  <span class="avatar" aria-hidden="true">{order.buyerUsername.charAt(0)}</span>
                  {order.buyerUsername}
                </span>
              </td>
              <td class="num">{order.quantity}</td>
              <td class="num">{peso(order.total)}</td>
              <td>
                <span class="pill pill-ok">Picked up</span>
              </td>
              <td class="muted">{order.pickedUpAt}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    </div>
  </section>
</AppLayout>

<script>
  import { announce } from '../../scripts/announce';
  import { run } from '../../scripts/request';
  import { api } from '../../api/client';

  document.querySelectorAll<HTMLButtonElement>('[data-ready]').forEach((button) => {
    button.addEventListener('click', async () => {
      const row = button.closest<HTMLElement>('[data-order]');
      const chip = row?.querySelector<HTMLElement>('[data-status-chip]');
      const cell = button.parentElement;
      if (!chip || !cell) return;

      const order = await run(button, () => api.seller.markReady(button.dataset.ready ?? ''));
      if (!order) return;

      chip.className = 'pill pill-ok';
      chip.textContent = 'Ready for pickup';

      const waiting = document.createElement('span');
      waiting.className = 'small muted';
      waiting.textContent = 'Waiting for buyer';
      cell.replaceChildren(waiting);

      // The button is gone; move to the next order to hand over.
      const next = document.querySelector<HTMLElement>('[data-ready]');
      if (next) {
        next.focus();
      } else {
        waiting.tabIndex = -1;
        waiting.focus();
      }

      const food = row?.querySelector<HTMLElement>('.name')?.textContent?.trim() ?? 'Order';
      announce(`${food} is ready for pickup. The buyer can see it now.`);
    });
  });
</script>

