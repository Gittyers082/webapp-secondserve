---
import AuthLayout from '../layouts/AuthLayout.astro';
---

<AuthLayout
  title="Create Account"
  headline="Give good products a second chance."
  accent="a second chance."
  lede="Create a seller account to list surplus, or a buyer account to find it."
>
  <p class="note" slot="hero-extra">Business name field appears only when Seller is chosen (shown here).</p>

  <form class="register" method="get" action="/login">
    <h2>Create an account</h2>

    <div class="field">
      <label class="field-label" for="new-username">Username</label>
      <input class="input" id="new-username" name="username" value="mangben_owner" autocomplete="username" />
    </div>

    <div class="field">
      <label class="field-label" for="new-password">Password</label>
      <input class="input" id="new-password" name="password" type="password" value="secondserve" autocomplete="new-password" />
    </div>

    <div class="field">
      <span class="field-label">Account type</span>
      <div class="roles" role="radiogroup" aria-label="Account type">
        <button class="role" type="button" data-role="buyer" aria-pressed="false">Buyer</button>
        <button class="role" type="button" data-role="seller" aria-pressed="true">Seller</button>
      </div>
    </div>

    <div class="field" data-shop-field>
      <label class="field-label" for="shop">Shop / business name</label>
      <input class="input" id="shop" name="shop" value="Mang Ben's Bakery" />
    </div>

    <p class="notice notice-info">
      <strong>Pending approval.</strong> Your account is pending admin approval. You can sign in once approved.
    </p>

    <button class="btn btn-primary btn-lg btn-block" type="submit">Create account</button>
    <a class="btn btn-block back" href="/login">Back to login</a>
  </form>
</AuthLayout>

<script>
  const shopField = document.querySelector<HTMLElement>('[data-shop-field]');

  document.querySelectorAll<HTMLButtonElement>('.role').forEach((button) => {
    button.addEventListener('click', () => {
      document.querySelectorAll<HTMLButtonElement>('.role').forEach((other) => {
        other.setAttribute('aria-pressed', String(other === button));
      });
      if (shopField) shopField.hidden = button.dataset.role !== 'seller';
    });
  });
</script>

<style>
  .note {
    margin-top: 30px;
    max-width: 42ch;
    color: var(--muted);
    font-size: 13px;
    border-left: 2px solid var(--line-strong);
    padding-left: 14px;
  }

  .register h2 {
    font-family: var(--display);
    font-weight: 400;
    font-size: 34px;
    margin-bottom: 22px;
    letter-spacing: -0.01em;
  }

  .roles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .role {
    height: 44px;
    border-radius: var(--r-pill);
    border: 1px solid var(--line-strong);
    background: var(--field);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .role[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .notice {
    margin-top: 18px;
  }

  .register .btn {
    margin-top: 18px;
  }

  .back {
    margin-top: 10px;
  }
</style>
