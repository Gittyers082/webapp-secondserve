---
import '../styles/global.css';

interface Props {
  /** Shown in the window chrome strip at the top of every screen. */
  title: string;
  description?: string;
}

const { title, description = 'A place at the table for everyone.' } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Apply the saved theme before the first paint so a reload never flashes.
      (function () {
        var theme = 'dark';
        try {
          if (localStorage.getItem('hapag-theme') === 'light') theme = 'light';
        } catch (error) {}
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <title>Hapag &mdash; {title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Instrument+Serif:ital@0;1&display=swap"
    />
    <link rel="icon" type="image/svg+xml" href="/brand/hapag-mark.svg" />
    <link rel="icon" type="image/png" href="/brand/hapag-mark.png" />
    <link rel="apple-touch-icon" href="/brand/hapag-mark.png" />
    <meta property="og:title" content={`Hapag — ${title}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/brand/hapag-logo.png" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <div data-app-root>
      <div class="window-chrome" aria-hidden="true">
        <span class="lights"><i></i><i></i><i></i></span>
        <span class="window-title">Hapag &mdash; {title}</span>
      </div>
      <slot />
    </div>
    <p class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-announcer></p>
    <p class="toast" data-toast hidden></p>
    <script>
      import { initThemeToggles } from '../scripts/theme';
      import { initTips } from '../scripts/tips';
      initThemeToggles();
      initTips();
    </script>
  </body>
</html>

<style>
  .window-chrome {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: var(--chrome-h);
    padding: 0 20px;
    background: var(--glass-strong);
    -webkit-backdrop-filter: var(--blur);
    backdrop-filter: var(--blur);
  }

  .lights {
    position: absolute;
    left: 20px;
    display: flex;
    gap: 8px;
  }

  .lights i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--s4);
  }

  .window-title {
    font-size: var(--fs-sm);
    color: var(--muted);
  }
</style>
