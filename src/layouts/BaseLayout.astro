---
import '../styles/global.css';

interface Props {
  /** Shown in the window chrome strip at the top of every screen. */
  title: string;
  description?: string;
}

const { title, description = 'Good products deserve a second chance.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SecondServe &mdash; {title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Instrument+Serif:ital@0;1&display=swap"
    />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48'%3E%3Crect width='48' height='48' rx='11' fill='%23f6eddc'/%3E%3Cpath d='M9 30c8.5-9 17.5-13.5 30-15-3.5 6-9 10-15.5 12.5' fill='none' stroke='%23c13d1f' stroke-width='4' stroke-linecap='round'/%3E%3C/svg%3E"
    />
  </head>
  <body>
    <div class="window-chrome">
      <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="window-title">SecondServe &mdash; {title}</span>
    </div>
    <slot />
  </body>
</html>

<style>
  .window-chrome {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    padding: 0 20px;
    background: var(--paper-soft);
    border-bottom: 1px solid var(--line);
  }

  .lights {
    position: absolute;
    left: 20px;
    display: flex;
    gap: 8px;
  }

  .lights i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--line-strong);
  }

  .window-title {
    font-size: 12.5px;
    color: var(--muted);
  }
</style>
