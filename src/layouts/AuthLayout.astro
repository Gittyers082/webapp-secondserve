---
import BaseLayout from './BaseLayout.astro';
import Logo from '../components/Logo.astro';
import FoodArt from '../components/FoodArt.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  /** Headline; the words in `accent` are set in brick. */
  headline: string;
  accent?: string;
  lede: string;
}

const { title, headline, accent, lede } = Astro.props;
const [before, after] = accent ? headline.split(accent) : [headline, ''];
---

<BaseLayout title={title}>
  <div class="auth">
    <main class="auth-grid" id="main" tabindex="-1">
      <section class="hero">
        <Logo size={26} />
        <h1>
          {before}{accent && <span class="hl">{accent}</span>}{after}
        </h1>
        <p class="lede">{lede}</p>
        <slot name="hero-extra" />

        <div class="strip" aria-hidden="true">
          <FoodArt art="pandesal-ube" ratio="3 / 4" eager />
          <FoodArt art="croissant" ratio="3 / 4" eager />
          <FoodArt art="ensaymada" ratio="3 / 4" eager />
        </div>
      </section>

      <section class="card">
        <slot />
      </section>
    </main>

    <footer class="auth-foot">
      <span>SecondServe Desktop</span>
      <ThemeToggle variant="pill" />
      <span>Good products deserve a second chance</span>
    </footer>
  </div>
</BaseLayout>

<style>
  .auth {
    display: flex;
    flex-direction: column;
    min-height: calc(100vh - var(--chrome-h));
    background: var(--s1);
  }

  .auth-grid {
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(380px, 0.9fr);
    gap: 64px;
    align-items: center;
    width: 100%;
    max-width: 1320px;
    margin: 0 auto;
    padding: 48px 48px;
  }

  .auth-grid:focus {
    outline: none;
  }

  .hero h1 {
    margin-top: 40px;
    font-size: clamp(38px, 3.8vw, 54px);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .lede {
    margin-top: 16px;
    max-width: 46ch;
    color: var(--text-soft);
    font-size: var(--fs-lg);
    line-height: 1.55;
  }

  .strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    max-width: 520px;
    margin-top: 40px;
  }

  .strip :global(.food-photo) {
    border-radius: var(--r-lg);
  }

  .strip :global(.food-photo:nth-child(2)) {
    transform: translateY(18px);
  }

  .card {
    background: var(--s2);
    border-radius: var(--r-xl);
    padding: 40px;
  }

  .card :global(h2) {
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .auth-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 48px;
    border-top: 1px solid var(--line);
    font-size: var(--fs-sm);
    color: var(--muted);
  }

  @media (max-width: 1100px) {
    .auth-grid {
      grid-template-columns: minmax(0, 1fr) minmax(360px, 1fr);
      gap: 40px;
      padding: 40px 32px;
    }

    .strip {
      display: none;
    }
  }
</style>
