---
import BaseLayout from './BaseLayout.astro';
import Logo from '../components/Logo.astro';

interface Props {
  title: string;
  /** Headline; the words in `accent` are set in red serif italic. */
  headline: string;
  accent?: string;
  lede: string;
}

const { title, headline, accent, lede } = Astro.props;
const [before, after] = accent ? headline.split(accent) : [headline, ''];
---

<BaseLayout title={title}>
  <div class="auth">
    <div class="auth-grid shell">
      <section class="hero">
        <Logo size={34} />
        <h1>
          {before}
          {accent && <em>{accent}</em>}
          {after}
        </h1>
        <p class="lede">{lede}</p>
        <slot name="hero-extra" />
      </section>

      <section class="card">
        <slot />
      </section>
    </div>

    <footer class="auth-foot">
      <span>SecondServe Desktop</span>
      <span>Good products deserve a second chance</span>
    </footer>
  </div>
</BaseLayout>

<style>
  .auth {
    display: flex;
    flex-direction: column;
    min-height: calc(100vh - 44px);
  }

  .auth-grid {
    flex: 1;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 72px;
    align-items: center;
    padding-top: 40px;
    padding-bottom: 40px;
  }

  .hero h1 {
    margin-top: 28px;
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(44px, 4.6vw, 70px);
    line-height: 1.02;
    letter-spacing: -0.015em;
  }

  .hero h1 em {
    font-style: italic;
    color: var(--brick);
  }

  .lede {
    margin-top: 20px;
    max-width: 44ch;
    color: var(--ink-soft);
    font-size: 16px;
    line-height: 1.55;
  }

  .card {
    background: var(--tan);
    border-radius: 22px;
    padding: 34px;
  }

  .auth-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 13px var(--gutter);
    border-top: 1px solid var(--line);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (max-width: 1000px) {
    .auth-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
