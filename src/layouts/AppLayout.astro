---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import { navFor, roleLabel } from '../data/nav';
import type { Role } from '../data/types';

interface Props {
  role: Role;
  username: string;
  /** Section name, used for the window title: "Buyer · Shop". */
  section: string;
  /** Page title. */
  heading: string;
  /** One line under the title. */
  subtitle?: string;
  /** Words in the subtitle set in brick: usually the figure that matters. */
  highlight?: string;
}

const { role, username, section, heading, subtitle, highlight } = Astro.props;
const nav = navFor(role);
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const hasRail = Astro.slots.has('rail');
const hasActions = Astro.slots.has('actions');

const [before, after] = highlight && subtitle ? subtitle.split(highlight) : [subtitle, ''];
---

<BaseLayout title={`${roleLabel[role]} · ${section}`}>
  <div class:list={['app', { 'has-rail': hasRail }]}>
    <Sidebar role={role} username={username} nav={nav} current={current} />

    <main class="main" id="main" tabindex="-1">
      <header class="page-head">
        <div>
          <h1>{heading}</h1>
          {
            subtitle && (
              <p class="section-sub">
                {before}{highlight && <span class="hl">{highlight}</span>}{after}
              </p>
            )
          }
        </div>
        {hasActions && <div class="page-actions"><slot name="actions" /></div>}
      </header>

      <slot />
    </main>

    {
      hasRail && (
        <aside class="rail" aria-label={`${heading} summary`}>
          <slot name="rail" />
        </aside>
      )
    }
  </div>
</BaseLayout>

<style>
  .app {
    display: grid;
    grid-template-columns: var(--sidebar) minmax(0, 1fr);
    align-items: start;
    min-height: calc(100vh - var(--chrome-h));
    background: var(--s1);
  }

  .app.has-rail {
    grid-template-columns: var(--sidebar) minmax(0, 1fr) var(--rail);
  }

  .main {
    min-width: 0;
    padding: var(--sp-8) var(--pad) var(--sp-16);
  }

  .main:focus {
    outline: none;
  }

  .page-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: var(--sp-8);
  }

  .page-head h1 {
    font-size: var(--fs-h1);
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.15;
  }

  .page-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    flex: none;
  }

  .rail {
    position: sticky;
    top: 0;
    max-height: calc(100vh - var(--chrome-h));
    overflow-y: auto;
    padding: var(--sp-8) var(--pad) var(--sp-8) 0;
  }

  @media (max-width: 1279px) {
    .app,
    .app.has-rail {
      --rail: 296px;
      grid-template-columns: var(--sidebar-compact) minmax(0, 1fr);
    }

    .app.has-rail {
      grid-template-columns: var(--sidebar-compact) minmax(0, 1fr) var(--rail);
    }

    .main {
      padding-left: var(--sp-8);
      padding-right: var(--sp-6);
    }

    .rail {
      padding-right: var(--sp-6);
    }
  }

  /* Below 1000px the summary rail moves under the main column. */
  @media (max-width: 999px) {
    .app.has-rail {
      grid-template-columns: var(--sidebar-compact) minmax(0, 1fr);
      grid-template-areas:
        'side main'
        'side rail';
    }

    .app.has-rail > :global(.sidebar) { grid-area: side; }
    .app.has-rail .main { grid-area: main; padding-bottom: 24px; }

    .rail {
      grid-area: rail;
      position: static;
      max-height: none;
      overflow: visible;
      padding: 0 24px 64px 32px;
    }
  }
</style>
