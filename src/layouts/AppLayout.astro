---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { navFor, notificationsFor, notificationsHref, roleLabel } from '../data/nav';
import { unreadCount } from '../data/store';
import type { Role } from '../data/types';

interface Props {
  role: Role;
  username: string;
  /** Section name, used for the window title: "Buyer · Shop". */
  section: string;
  /** Page title. */
  heading: string;
  /** One line under the title. */
  subtitle?: string;
  /** Words in the subtitle set in brick: usually the figure that matters. */
  highlight?: string;
  /** Sidebar item to mark as current when the page itself is not in the menu. */
  activeHref?: string;
}

const { role, username, section, heading, subtitle, highlight, activeHref } = Astro.props;
const nav = navFor(role);
const current = activeHref ?? (Astro.url.pathname.replace(/\/$/, '') || '/');
const hasRail = Astro.slots.has('rail');
const hasActions = Astro.slots.has('actions');
const unread = unreadCount(notificationsFor[role]);

// Only highlight words that are really in the subtitle; otherwise show it plain.
const [before, after] =
  highlight && subtitle && subtitle.includes(highlight) ? subtitle.split(highlight) : [subtitle, ''];
const showHighlight = Boolean(highlight && subtitle?.includes(highlight));
---

<BaseLayout title={`${roleLabel[role]} · ${section}`}>
  <p class="auth-loading" data-auth-loading role="status">Checking your account...</p>
  <div class:list={['app', { 'has-rail': hasRail }]} data-required-role={role} hidden>
    <!-- Top bar below 1000px: the menu, the brand, notifications and theme -->
    <header class="mobile-bar" data-page-content>
      <button
        class="bar-btn"
        type="button"
        data-nav-open
        aria-controls="app-nav"
        aria-expanded="false"
        aria-label="Open menu"
      >
        <Icon name="menu" />
      </button>
      <a class="bar-brand" href={nav[0]!.href} aria-label="Hapag home"><Logo size={20} /></a>
      <a
        class="bar-btn"
        href={notificationsHref[role]}
        aria-label={unread ? `Notifications, ${unread} unread` : 'Notifications'}
      >
        <Icon name="bell" />
        {unread > 0 && <span class="bar-dot" aria-hidden="true"></span>}
      </a>
      <ThemeToggle />
    </header>

    <div class="nav-scrim" data-nav-close aria-hidden="true"></div>

    <Sidebar role={role} username={username} nav={nav} current={current} />

    <main class="main" id="main" tabindex="-1" data-page-content>
      <header class="page-head">
        <div>
          <h1>{heading}</h1>
          {
            subtitle && (
              <p class="section-sub">
                {before}{showHighlight && <span class="hl">{highlight}</span>}{after}
              </p>
            )
          }
        </div>
        {hasActions && <div class="page-actions"><slot name="actions" /></div>}
      </header>

      <slot />
    </main>

    {
      hasRail && (
        <aside class="rail" aria-label={`${heading} summary`} data-page-content>
          <slot name="rail" />
        </aside>
      )
    }
  </div>
</BaseLayout>

<script>
  import { initNavDrawer } from '../scripts/nav-drawer';
  import { initAccountUi } from '../scripts/account-ui';
  initNavDrawer();
  void initAccountUi();
</script>

<style>
  .auth-loading {
    padding: 32px;
    text-align: center;
    color: var(--muted);
  }
  .app[hidden] { display: none; }
  .app {
    display: grid;
    grid-template-columns: var(--sidebar) minmax(0, 1fr);
    align-items: start;
    width: 100%;
    max-width: var(--app-max);
    min-height: 100vh;
    margin: 0 auto;
  }

  .mobile-bar,
  .nav-scrim {
    display: none;
  }

  .app.has-rail {
    grid-template-columns: var(--sidebar) minmax(0, 1fr) var(--rail);
  }

  .main {
    min-width: 0;
    padding: var(--sp-8) var(--pad) var(--sp-16);
  }

  .main:focus {
    outline: none;
  }

  .page-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: var(--sp-8);
  }

  .page-head h1 {
    font-size: var(--fs-h1);
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.15;
  }

  .page-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    flex: none;
  }

  .rail {
    position: sticky;
    top: 0;
    max-height: 100vh;
    overflow-y: auto;
    padding: var(--sp-8) var(--pad) var(--sp-8) 0;
  }

  @media (max-width: 1279px) {
    .app,
    .app.has-rail {
      --rail: 296px;
      grid-template-columns: var(--sidebar-compact) minmax(0, 1fr);
    }

    .app.has-rail {
      grid-template-columns: var(--sidebar-compact) minmax(0, 1fr) var(--rail);
    }

    .main {
      padding-left: var(--sp-8);
      padding-right: var(--sp-6);
    }

    .rail {
      padding-right: var(--sp-6);
    }
  }

  /* Below 1000px: a top bar with the menu, one column, the rail under it. */
  @media (max-width: 999px) {
    .app,
    .app.has-rail {
      display: block;
    }

    .mobile-bar {
      position: sticky;
      top: 0;
      z-index: 40;
      display: flex;
      align-items: center;
      gap: var(--sp-2);
      padding: var(--sp-2) var(--sp-4);
      background: var(--glass-strong);
      -webkit-backdrop-filter: var(--blur);
      backdrop-filter: var(--blur);
    }

    .bar-brand {
      flex: 1;
      min-width: 0;
      display: flex;
      align-items: center;
      min-height: var(--target);
      padding: 0 var(--sp-2);
    }

    .bar-btn {
      position: relative;
      display: grid;
      place-items: center;
      flex: none;
      width: var(--target);
      height: var(--target);
      border: 0;
      border-radius: 50%;
      background: var(--s3);
      color: var(--text);
    }

    .bar-dot {
      position: absolute;
      top: 9px;
      right: 10px;
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: var(--lime);
    }

    .nav-scrim {
      position: fixed;
      inset: 0;
      z-index: 75;
      background: var(--scrim);
    }

    :global(html[data-nav='open']) .nav-scrim {
      display: block;
    }

    .main {
      padding: var(--sp-6) var(--sp-6) var(--sp-8);
    }

    .rail {
      position: static;
      max-height: none;
      overflow: visible;
      padding: 0 var(--sp-6) var(--sp-16);
    }
  }

  @media (max-width: 599px) {
    .main {
      padding: var(--sp-5) var(--sp-4) var(--sp-8);
    }

    .rail {
      padding: 0 var(--sp-4) var(--sp-12);
    }

    .page-head {
      flex-direction: column;
      align-items: stretch;
      margin-bottom: var(--sp-6);
    }

    .page-head h1 {
      font-size: var(--fs-h2);
    }
  }
</style>
