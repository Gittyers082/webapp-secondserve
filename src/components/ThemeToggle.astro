---
import Icon from './Icon.astro';

interface Props {
  /** `nav` matches the sidebar items; `pill` is a small bordered button. */
  variant?: 'nav' | 'pill';
  class?: string;
}

const { variant = 'pill', class: className } = Astro.props;
---

<button
  class:list={['theme-toggle', `theme-toggle-${variant}`, className]}
  type="button"
  role="switch"
  aria-checked="false"
  data-theme-toggle
  title="Light mode"
>
  <span class="theme-icon" aria-hidden="true">
    <span class="when-dark"><Icon name="sun" /></span>
    <span class="when-light"><Icon name="moon" /></span>
  </span>
  <span class="theme-label">Light mode</span>
  <span class="theme-track" aria-hidden="true"></span>
</button>

<style>
  .theme-toggle {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    border: 0;
    background: transparent;
    color: var(--text-soft);
    font-size: var(--fs-md);
    font-weight: 500;
    text-align: left;
    transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }

  .theme-toggle:hover {
    color: var(--text);
    background: var(--hover);
  }

  .theme-toggle-nav {
    width: 100%;
    min-height: 46px;
    padding: 0 var(--sp-3);
    border-radius: var(--r-md);
  }

  .theme-toggle-pill {
    height: 36px;
    padding: 0 var(--sp-4);
    border: 1px solid var(--line-control);
    border-radius: var(--r-pill);
  }

  .theme-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 36px;
    height: 36px;
  }

  .theme-toggle-pill .theme-icon {
    width: 18px;
    height: 18px;
  }

  .theme-toggle-pill .theme-icon :global(svg) {
    width: 18px;
    height: 18px;
  }

  .when-light {
    display: none;
  }

  :global(:root[data-theme='light']) .when-light {
    display: contents;
  }

  :global(:root[data-theme='light']) .when-dark {
    display: none;
  }

  .when-dark {
    display: contents;
  }

  .theme-label {
    flex: 1;
  }

  /* A small switch track that reads on/off at a glance */
  .theme-track {
    position: relative;
    flex: none;
    width: 34px;
    height: 20px;
    border-radius: var(--r-pill);
    background: var(--s4);
    box-shadow: inset 0 0 0 1px var(--line-control);
    transition: background var(--dur) var(--ease-out);
  }

  .theme-track::after {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--text);
    transition: transform var(--dur) var(--ease-out);
  }

  .theme-toggle[aria-checked='true'] .theme-track {
    background: var(--brick);
    box-shadow: none;
  }

  .theme-toggle[aria-checked='true'] .theme-track::after {
    transform: translateX(14px);
    background: #fff;
  }
</style>
