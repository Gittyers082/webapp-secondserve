---
interface Props {
  /** Height of the wordmark in pixels; the mark scales with it. */
  size?: number;
  /**
   * `lockup` pairs the mark with the wordmark, as the app chrome does.
   * `mark` is the tile on its own.
   * `full` is the supplied square logo, wordmark included.
   */
  variant?: 'lockup' | 'mark' | 'full';
  class?: string;
}

const { size = 26, variant = 'lockup', class: className } = Astro.props;
---

{
  variant === 'full' ? (
    <img
      class:list={['logo-full', className]}
      src="/brand/secondserve-logo.png"
      width="640"
      height="640"
      style={`width:${size * 7}px`}
      alt="SecondServe"
    />
  ) : (
    <span class:list={['logo', className]} style={`--logo-size:${size}px`}>
      <img class="logo-mark" src="/brand/secondserve-mark.png" width="512" height="512" alt="" />
      {variant === 'lockup' && (
        <span class="logo-word">
          <em>second</em>
          <strong>serve</strong>
        </span>
      )}
      <span class="sr-only">SecondServe</span>
    </span>
  )
}

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  .logo-mark {
    width: calc(var(--logo-size) * 1.42);
    height: calc(var(--logo-size) * 1.42);
    flex: none;
  }

  .logo-word {
    font-family: var(--display);
    font-size: var(--logo-size);
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .logo-word em {
    font-style: italic;
    font-weight: 400;
  }

  .logo-word strong {
    font-weight: 700;
    font-family: var(--sans);
    font-size: 0.92em;
    letter-spacing: -0.02em;
  }

  .logo-full {
    height: auto;
    border-radius: var(--r-lg);
  }
</style>
