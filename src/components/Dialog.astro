---
interface Props {
  /** Used by `data-dialog-open="<id>"` triggers anywhere on the page. */
  id: string;
  title: string;
  message?: string;
  /** Widens the dialog for forms such as Edit listing. */
  wide?: boolean;
}

const { id, title, message, wide = false } = Astro.props;
const titleId = `${id}-title`;
const messageId = `${id}-message`;
---

<div class="scrim" data-dialog={id} hidden>
  <div
    class:list={['dialog', { wide }]}
    role="dialog"
    aria-modal="true"
    aria-labelledby={titleId}
    aria-describedby={message !== undefined ? messageId : undefined}
    tabindex="-1"
  >
    <h2 id={titleId} data-dialog-title>{title}</h2>
    {message !== undefined && <p id={messageId} data-dialog-message>{message}</p>}
    <slot />
  </div>
</div>

<script>
  import { initDialogs } from '../scripts/dialog';
  initDialogs();
</script>

<style>
  .wide {
    width: min(760px, 100%);
  }

  .dialog:focus {
    outline: none;
  }
</style>
