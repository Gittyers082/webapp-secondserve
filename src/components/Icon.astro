---
/**
 * The app's icon set: 24px outline icons drawn on one grid with one stroke
 * weight, so every icon in the app reads as part of the same family.
 * Decorative by default; pass `label` when the icon stands alone.
 */
import type { IconName } from '../data/icons';

interface Props {
  name: IconName;
  size?: number;
  label?: string;
  class?: string;
}

const { name, size = 20, label, class: className } = Astro.props;

const paths: Record<IconName, string> = {
