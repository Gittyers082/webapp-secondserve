  'list-check': 'M10 6h10M10 12h10M10 18h10M3.5 6l1.5 1.5L7.5 5M3.5 12l1.5 1.5L7.5 11M3.5 18l1.5 1.5L7.5 17',
  flag: 'M5 21V4M5 4h11l-2 4 2 4H5',
