  'chevron-right': 'M9 5l7 7-7 7',
  check: 'M5 12.5l4.5 4.5L19 7',
  camera: 'M4 8h3l2-3h6l2 3h3v11H4V8zM12 16.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z',
