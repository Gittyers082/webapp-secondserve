---
import FoodArt from './FoodArt.astro';
import Icon from './Icon.astro';
import { peso } from '../data/types';
import type { Listing } from '../data/types';

interface Props {
  listing: Listing;
  /** `shop` shows stock + a Details button, `seller` shows qty + lifecycle state. */
  variant?: 'shop' | 'seller' | 'moderation';
  /** Renders the card as a selectable tile with a checkmark. */
  selectable?: boolean;
  selected?: boolean;
}

const { listing, variant = 'shop', selectable = false, selected = false } = Astro.props;

const expired = listing.status === 'expired';
const expiringSoon =
  !expired && listing.status === 'active' && listing.expiresAt !== '' && listing.expiresAt <= '2026-11-07';

const stateChip = (() => {
  switch (listing.status) {
    case 'sold':
      return { label: 'Sold', tone: 'pill-neutral' };
    case 'withdrawn':
      return { label: 'Withdrawn', tone: 'pill-neutral' };
    case 'expired':
      return { label: 'Expired', tone: 'pill-danger' };
    default:
      return {
        label: listing.reserved ? `Active · ${listing.reserved} reserved` : 'Active',
        tone: 'pill-ok',
      };
  }
})();

const quantityLabel =
  listing.status === 'sold' && listing.originalQuantity
    ? `0 of ${listing.originalQuantity} left`
    : `${listing.quantity} left`;
---

<article
  class:list={['card', { 'is-selectable': selectable, 'is-selected': selected, 'is-expired': expired }]}
  data-listing={listing.id}
  data-category={listing.category}
  data-status={listing.status}
  data-name={listing.name.toLowerCase()}
  data-shop={listing.shopName.toLowerCase()}
  data-qty={listing.quantity}
  data-expiry={listing.expiryLabel}
  data-price={peso(listing.discountedPrice)}
>
  <div
    class="thumb"
    data-select={selectable ? '' : undefined}
    role={selectable ? 'button' : undefined}
    tabindex={selectable ? 0 : undefined}
    aria-pressed={selectable ? (selected ? 'true' : 'false') : undefined}
    aria-label={selectable ? `Select ${listing.name}` : undefined}
    aria-disabled={selectable && variant === 'shop' && expired ? true : undefined}
  >
    <FoodArt art={listing.art} muted={expired} />

    {listing.flagged && <span class="pill pill-danger badge">Flagged</span>}
    {!listing.flagged && expired && <span class="pill pill-danger badge">Expired</span>}
    {!listing.flagged && expiringSoon && <span class="pill pill-lime badge">Expiring soon</span>}

    {
      selectable && (
        <span class="tick" aria-hidden="true">
          <Icon name="check" size={16} />
        </span>
      )
    }
  </div>

  <div class="body">
    <h3 data-card-name>{listing.name}</h3>
    {variant !== 'seller' && <p class="shop" data-card-shop>{listing.shopName}</p>}

    <div class="price-row">
      <span class="price">
        {listing.originalPrice !== listing.discountedPrice && <del>{peso(listing.originalPrice)}</del>}
        <ins>{peso(listing.discountedPrice)}</ins>
      </span>
      <span class="left tnum">{variant === 'shop' ? `${listing.quantity} left` : quantityLabel}</span>
    </div>

    <p class="expires">
      <Icon name="clock" size={15} />
      <span><span class="sr-only">Expires </span>{listing.expiryLabel}</span>
    </p>

    {
      variant === 'shop' && (
        <div class="foot">
          {expired ? (
            <button class="btn btn-sm btn-block" type="button" disabled>
              Unavailable
            </button>
          ) : (
            <button
              class="btn btn-sm btn-block"
              type="button"
              data-details-for={listing.id}
              data-dialog-open="details"
              aria-haspopup="dialog"
              aria-label={`Details: ${listing.name}`}
            >
              Details
            </button>
          )}
        </div>
      )
    }

    {
      variant !== 'shop' && (
        <div class="foot">
          <span
            class:list={['pill', variant === 'moderation' && listing.flagged ? 'pill-danger' : stateChip.tone]}
            data-state
          >
            {variant === 'moderation' && listing.flagged ? 'Flagged' : stateChip.label}
          </span>
        </div>
      )
    }
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    padding: 12px;
    border-radius: var(--r-lg);
    background: var(--s2);
    outline: 2px solid transparent;
    outline-offset: -2px;
    transition: background var(--dur) var(--ease-out), outline-color var(--dur-fast) var(--ease-out);
  }

  .card:hover {
    background: var(--s3);
  }

  .card:hover :global(.photo) {
    transform: scale(1.04);
  }

  .thumb {
    position: relative;
    border-radius: var(--r-md);
  }

  .is-selectable .thumb {
    cursor: pointer;
  }

  .is-selectable .thumb[aria-disabled='true'] {
    cursor: not-allowed;
  }

  .is-selectable .thumb:focus-visible {
    outline: 2px solid var(--lime);
    outline-offset: 3px;
  }

  .is-selected {
    outline-color: var(--brick);
  }

  .badge {
    position: absolute;
    top: 10px;
    left: 10px;
  }

  .tick {
    position: absolute;
    top: 10px;
    right: 10px;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--brick);
    color: #fff;
    opacity: 0;
    transform: scale(0.6);
    transition: opacity var(--dur-fast) var(--ease-out), transform var(--dur) var(--ease-out);
  }

  .is-selected .tick {
    opacity: 1;
    transform: none;
  }

  .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 16px 8px 8px;
  }

  h3 {
    font-size: var(--fs-body);
    font-weight: 700;
    line-height: 1.3;
  }

  .shop {
    margin-top: 2px;
    color: var(--muted);
    font-size: var(--fs-sm);
  }

  .price-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-top: 12px;
  }

  .left {
    color: var(--text-soft);
    font-size: var(--fs-sm);
    white-space: nowrap;
  }

  .expires {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
    color: var(--muted);
    font-size: var(--fs-sm);
  }

  .expires :global(svg) {
    flex: none;
  }

  .foot {
    margin-top: auto;
    padding-top: 16px;
  }

  .is-expired h3,
  .is-expired .price ins {
    color: var(--muted);
  }
</style>
