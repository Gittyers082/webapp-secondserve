---
interface Props {
  value?: number;
  min?: number;
  max?: number;
  label?: string;
  /** Hook used by page scripts to find this stepper. */
  name?: string;
}

const { value = 1, min = 1, max = 99, label = 'Quantity', name = 'quantity' } = Astro.props;
---

<div class="stepper" data-stepper={name} data-min={min} data-max={max} role="group" aria-labelledby={`${name}-qty-label`}>
  <span class="field-label stepper-label" id={`${name}-qty-label`}>{label}</span>
  <div class="controls">
    <button type="button" class="step" data-step="-1" aria-label={`Decrease ${label.toLowerCase()}`} disabled={value <= min}>&minus;</button>
    <output class="value tnum" data-stepper-value aria-live="polite">{value}</output>
    <button type="button" class="step" data-step="1" aria-label={`Increase ${label.toLowerCase()}`} disabled={value >= max}>+</button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-stepper]').forEach((stepper) => {
    const output = stepper.querySelector<HTMLOutputElement>('[data-stepper-value]');
    if (!output) return;

    const min = Number(stepper.dataset.min ?? 1);
    const max = Number(stepper.dataset.max ?? 99);
    const buttons = Array.from(stepper.querySelectorAll<HTMLButtonElement>('[data-step]'));

    const sync = (value: number) => {
      buttons.forEach((button) => {
        const delta = Number(button.dataset.step);
        button.disabled = delta < 0 ? value <= min : value >= max;
      });
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const delta = Number(button.dataset.step);
        const next = Math.min(max, Math.max(min, Number(output.textContent) + delta));
        output.textContent = String(next);
        sync(next);
        // Keep focus on a usable control when this one just became disabled.
        if (button.disabled) buttons.find((other) => other !== button)?.focus();
        stepper.dispatchEvent(new CustomEvent('quantitychange', { detail: next, bubbles: true }));
      });
    });
  });
</script>

<style>
  .stepper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .stepper-label {
    margin-bottom: 0;
  }

  .controls {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  .step {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 0;
    border-radius: 50%;
    background: var(--s3);
    color: var(--text);
    font-size: 17px;
    line-height: 1;
    transition: background var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }

  .step:hover:not(:disabled) { background: var(--s4); }
  .step:active:not(:disabled) { transform: scale(0.92); }

  .step:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .value {
    min-width: 22px;
    text-align: center;
    font-size: var(--fs-body);
    font-weight: 700;
  }
</style>
