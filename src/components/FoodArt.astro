---
import type { FoodArt } from '../data/types';

interface Props {
  art: FoodArt;
  /** Greys the photo out, used for expired listings. */
  muted?: boolean;
  /** Width and height ratio of the frame, e.g. "4 / 3" or "1 / 1". */
  ratio?: string;
  /** Load straight away, at high priority, instead of when scrolled near. */
  eager?: boolean;
  /** How wide the photo is drawn, so the browser picks the small or large file. */
  sizes?: string;
  class?: string;
}

const {
  art,
  muted = false,
  ratio = '4 / 3',
  eager = false,
  sizes = '(max-width: 600px) 92vw, 320px',
  class: className,
} = Astro.props;

/*
 * Openly licensed photographs from Wikimedia Commons, stored in
 * public/photos/ and credited in public/photos/CREDITS.md. They stand in for
 * the sellers' own photos until listings carry real uploads.
 *
 * Each photo has a 480px copy in public/photos/480/ for cards and thumbnails
 * and a 960px original for large views; both are progressive JPEGs, and the
 * frame shows a tinted placeholder until the image arrives (NFR-USER-U-6).
 */
const photos: Record<FoodArt, { alt: string; width: number; height: number }> = {
  'pandesal-ube': { alt: 'Ube pandesal: purple bread rolls dusted with crumbs', width: 960, height: 715 },
  'pandesal-plain': { alt: 'Pandesal: small golden bread rolls in a paper bag', width: 960, height: 720 },
  croissant: { alt: 'Butter croissants stacked on a tray', width: 960, height: 1280 },
  empanada: { alt: 'Vigan empanadas with a dipping sauce', width: 960, height: 640 },
  'strawberry-cup': { alt: 'A handful of fresh strawberries', width: 960, height: 636 },
  'cake-slice': { alt: 'A slice of carrot cake with cream cheese frosting', width: 960, height: 723 },
  'cheese-roll': { alt: 'Cheese bread rolls in a basket', width: 960, height: 638 },
  monay: { alt: 'Monay: two split white bread rolls on a plate', width: 960, height: 632 },
  ensaymada: { alt: 'Ensaymada: coiled sweet buns dusted with sugar', width: 960, height: 732 },
  mystery: { alt: 'An assortment of bread rolls in a basket', width: 960, height: 640 },
};

const photo = photos[art];
---

<figure class:list={['food-photo', { 'is-muted': muted }, className]} style={`--ratio:${ratio}`}>
  <img
    class="photo"
    src={`/photos/480/${art}.jpg`}
    srcset={`/photos/480/${art}.jpg 480w, /photos/${art}.jpg 960w`}
    sizes={sizes}
    alt={photo.alt}
    width={photo.width}
    height={photo.height}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding="async"
  />
</figure>

<style>
  .food-photo {
    position: relative;
    margin: 0;
    width: 100%;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    border-radius: var(--r-md);
    background: var(--s3);
  }

  .photo {
    transition: transform var(--dur-slow) var(--ease-out), filter var(--dur) var(--ease-out);
  }

  .is-muted .photo {
    filter: grayscale(1) brightness(0.6);
  }
</style>
