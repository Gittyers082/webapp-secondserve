---
import type { SignupRole } from '../data/types';

interface Props {
  username: string;
  role: SignupRole;
}

const { username, role } = Astro.props;
const initial = role === 'seller' ? 'B' : username.charAt(0).toUpperCase();

const accountLabel: Record<SignupRole, string> = {
  buyer: 'Buyer account',
  seller: 'Seller account',
  partner: 'Partner account',
};

const note: Record<SignupRole, string> = {
  buyer: 'Sellers see "Seller account" here. Same screen for Buyer and Seller.',
  seller: 'Buyers see your shop name on every listing.',
  partner: 'Shops see your organization name on every order you place.',
};
---

<div class="profile">
  <aside class="identity panel">
    <span class="avatar avatar-lg" aria-hidden="true">{initial}</span>
    <p class="username">{username}</p>
    <p class="pill pill-neutral">{accountLabel[role]}</p>
    <p class="hint note">{note[role]}</p>
    <a class="btn btn-danger btn-block logout" href="/login">Log out of SecondServe</a>
  </aside>

  <div class="forms">
    <form class="block panel" method="post" data-demo-form data-success="Username updated.">
      <div class="field">
        <label class="field-label" for="username-field">Update username</label>
        <input class="input" id="username-field" name="username" value={username} autocomplete="username" required />
      </div>
      <div class="form-foot">
        <button class="btn" type="submit">Update username</button>
        <p class="form-status" data-form-status hidden></p>
      </div>
    </form>

    <form class="block panel" method="post" data-demo-form data-success="Password changed.">
      <div class="field">
        <label class="field-label" for="current-password">Current password</label>
        <input class="input" id="current-password" name="currentPassword" type="password" value="password" autocomplete="current-password" required />
      </div>

      <div class="field-row">
        <div>
          <label class="field-label" for="new-password">New password</label>
          <input class="input" id="new-password" name="newPassword" type="password" value="newpassword" autocomplete="new-password" required />
        </div>
        <div>
          <label class="field-label" for="confirm-password">Confirm new password</label>
          <input class="input" id="confirm-password" name="confirmPassword" type="password" value="newpassword" autocomplete="new-password" required />
        </div>
      </div>

      <div class="form-foot">
        <button class="btn" type="submit">Change password</button>
        <p class="form-status" data-form-status hidden></p>
      </div>
    </form>

  </div>
</div>

<script>
  import { initDemoForms } from '../scripts/demo-forms';
  initDemoForms();
</script>

<style>
  .profile {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    gap: var(--gutter);
    align-items: stretch;
  }

  .identity {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
    padding: 32px 24px;
  }

  .avatar-lg {
    width: 84px;
    height: 84px;
    margin-bottom: 8px;
    background: var(--brick);
    color: #fff;
    font-size: 32px;
  }

  .username {
    font-size: var(--fs-h2);
    font-weight: 700;
    line-height: 1.2;
  }

  .note {
    margin-top: 8px;
  }

  .block + .block {
    margin-top: var(--gutter);
  }

  .form-foot {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 20px;
  }

  .form-status {
    color: var(--ok);
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  .logout {
    margin-top: auto;
  }

  .note {
    margin-bottom: var(--sp-6);
  }

  @media (max-width: 1279px) {
    .profile {
      grid-template-columns: 240px minmax(0, 1fr);
    }
  }

  @media (max-width: 799px) {
    .profile {
      grid-template-columns: 1fr;
    }
  }
</style>
