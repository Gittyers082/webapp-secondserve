---
import type { SignupRole } from '../data/types';
interface Props { username: string; role: SignupRole; }
const { username, role } = Astro.props;
const accountLabel: Record<SignupRole, string> = {
  buyer: 'Buyer account', seller: 'Seller account', partner: 'Partner account',
};
const note: Record<SignupRole, string> = {
  buyer: 'Your account is connected to Supabase Auth.',
  seller: 'Buyers see your shop name on every listing.',
  partner: 'Shops see your organization name on every order you place.',
};
---

<div class="profile">
  <aside class="identity panel">
    <span class="avatar avatar-lg" aria-hidden="true">{username.charAt(0).toUpperCase()}</span>
    <p class="username">{username}</p>
    <p class="pill pill-neutral">{accountLabel[role]}</p>
    <p class="hint note">{note[role]}</p>
    <a class="btn btn-danger btn-block logout" href="/login" data-signout>Log out of SecondServe</a>
  </aside>

  <div class="forms">
    <div class="block panel">
      <div class="field">
        <label class="field-label" for="username-field">Username</label>
        <input class="input" id="username-field" value={username} autocomplete="username" readonly />
        <p class="hint field-hint">Username changes are not supported by the current backend.</p>
      </div>
    </div>

    <form class="block panel" method="post" data-password-form>
      <div class="field">
        <label class="field-label" for="current-password">Current password</label>
        <input class="input" id="current-password" name="currentPassword" type="password" autocomplete="current-password" required />
      </div>
      <div class="field-row">
        <div class="field">
          <label class="field-label" for="new-password">New password</label>
          <input class="input" id="new-password" name="newPassword" type="password" autocomplete="new-password" minlength="8" required />
        </div>
        <div class="field">
          <label class="field-label" for="confirm-password">Confirm new password</label>
          <input class="input" id="confirm-password" name="confirmPassword" type="password" autocomplete="new-password" minlength="8" required />
        </div>
      </div>
      <div class="form-foot">
        <button class="btn" type="submit">Change password</button>
        <p class="form-status" data-password-status role="status" hidden></p>
      </div>
    </form>
  </div>
</div>

<script>
  import { supabase } from '../api/supabase';
  import { signOut } from '../scripts/account-ui';
  const logout = document.querySelector<HTMLAnchorElement>('[data-signout]');
  logout?.addEventListener('click', (event) => {
    event.preventDefault();
    void signOut();
  });
  const form = document.querySelector<HTMLFormElement>('[data-password-form]');
  const status = form?.querySelector<HTMLElement>('[data-password-status]');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    const current = form.querySelector<HTMLInputElement>('#current-password')?.value ?? '';
    const next = form.querySelector<HTMLInputElement>('#new-password')?.value ?? '';
    const confirm = form.querySelector<HTMLInputElement>('#confirm-password')?.value ?? '';
    if (!status) return;
    status.hidden = false;
    if (next !== confirm) { status.textContent = 'Passwords do not match.'; return; }
    if (next === current) { status.textContent = 'Choose a different password.'; return; }
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (button) button.disabled = true;
    status.textContent = 'Updating password...';
    try {
      const { data } = await supabase.auth.getUser();
      if (!data.user?.email) throw new Error('Could not determine your signed-in email.');
      const verified = await supabase.auth.signInWithPassword({ email: data.user.email, password: current });
      if (verified.error) throw new Error('Current password is incorrect.');
      const result = await supabase.auth.updateUser({ password: next });
      if (result.error) throw result.error;
      status.textContent = 'Password updated successfully.';
      form.reset();
    } catch (error) {
      status.textContent = error instanceof Error ? error.message : 'Could not change password.';
    } finally {
      if (button) button.disabled = false;
    }
  });
</script>

<style>
  .profile {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    gap: var(--gutter);
    align-items: stretch;
  }

  .identity {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
    padding: 32px 24px;
  }

  .avatar-lg {
    width: 84px;
    height: 84px;
    margin-bottom: 8px;
    background: var(--brick);
    color: #fff;
    font-size: 32px;
  }

  .username {
    font-size: var(--fs-h2);
    font-weight: 700;
    line-height: 1.2;
  }

  .note {
    margin-top: 8px;
  }

  .block + .block {
    margin-top: var(--gutter);
  }

  .form-foot {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 20px;
  }

  .form-status {
    color: var(--ok);
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  .logout {
    margin-top: auto;
  }

  .note {
    margin-bottom: var(--sp-6);
  }

  @media (max-width: 1279px) {
    .profile {
      grid-template-columns: 240px minmax(0, 1fr);
    }
  }

  @media (max-width: 799px) {
    .profile {
      grid-template-columns: 1fr;
    }
  }
</style>
