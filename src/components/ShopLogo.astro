---
import { shopInitials } from '../data/types';

interface Props {
  name: string;
  logoUrl?: string;
  size?: number;
  class?: string;
}

const { name, logoUrl, size = 56, class: className } = Astro.props;
---

<span class:list={['shop-logo', className]} style={`--size:${size}px`} data-shop-logo>
  {logoUrl ? <img src={logoUrl} alt={`${name} logo`} /> : <span aria-hidden="true" data-shop-initials>{shopInitials(name)}</span>}
</span>

<style>
  .shop-logo {
    display: grid;
    place-items: center;
    flex: none;
    width: var(--size);
    height: var(--size);
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--brick);
    color: #fff;
    font-size: calc(var(--size) * 0.36);
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .shop-logo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--s3);
  }
</style>
